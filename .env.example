# Copy to .env and fill on the backend only. Never put credentials in Web/WeChat.
BANKMIND_DEMO=true
LLM_MODE=mock
LLM_ALLOW_EXTERNAL=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_PROVIDER=gemini
DOCUMENT_AI_MODEL=
DOCUMENT_AI_API_KEY=
OPENAI_API_KEY=
DOCUMENT_AI_FILE_GRANTS=
DOCUMENT_AI_CODEX_DEMO_SHA256=
DOCUMENT_AI_CODEX_DEMO_RECEIPT=
BANKMIND_WORK_MODE=off
BANKMIND_PILOT=false
BANKMIND_SIGNING_KEY_FILE=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides; leave commented to use the local storage/SQLite defaults.
# BANKMIND_STORAGE=E:/your-private-storage
# DATABASE_URL=postgresql+psycopg://user:password@localhost/bankmind

# DeepSeek for the mini program. Fill only the value of the API key in your local
# .env or the WeChat Cloud Run service settings.
BANKMIND_DEEPSEEK_KEY=
BANKMIND_DEEPSEEK_URL=https://eaichat.ctyun.cn/ai/platform/v2/cp
BANKMIND_DEEPSEEK_MODEL=deepseek-v4.1-flash
# In WeChat Cloud Run, set this to true to enable DeepSeek for the public trial.
# Keep LLM_MODE=mock for the default investigation option.
BANKMIND_TRIAL_DEEPSEEK_ENABLED=false
