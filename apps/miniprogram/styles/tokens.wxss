/* BankMind Unified Design System — Miniprogram Tokens
 * Light (明亮) & Dark (深色) semantic variables matching DESIGN.md
 */

page,
.theme-light {
  --bg-canvas: #F6F8FA;
  --bg-surface: #FFFFFF;
  --bg-subtle: #EFF3F6;
  --bg-elevated: rgba(255, 255, 255, 0.92);

  --text-primary: #111827;
  --text-secondary: #4B5563;
  --text-muted: #6B7280;

  --border-subtle: rgba(15, 23, 42, 0.08);
  --border-strong: rgba(15, 23, 42, 0.16);

  --accent: #0D9488;
  --accent-hover: #0F766E;
  --accent-pop: #14B8A6;
  --accent-soft: rgba(13, 148, 136, 0.10);
  --accent-on: #FFFFFF;

  --hero-grad-start: #0D9488;
  --hero-grad-end: #14B8A6;
  --hero-text: #FFFFFF;
  --hero-muted: rgba(255, 255, 255, 0.86);
  --hero-pill-bg: rgba(255, 255, 255, 0.18);

  --success: #059669;
  --success-soft: #ECFDF5;
  --warning: #D97706;
  --warning-soft: #FFFBEB;
  --danger: #DC2626;
  --danger-soft: #FEF2F2;
  --info: #2563EB;
  --info-soft: #EFF6FF;

  --shadow-sm: 0 2rpx 6rpx rgba(15, 23, 42, 0.04);
  --shadow-card: 0 8rpx 28rpx rgba(15, 23, 42, 0.05);
  --shadow-float: 0 20rpx 48rpx rgba(15, 23, 42, 0.10);

  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-full: 9999rpx;

  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

.theme-dark {
  --bg-canvas: #0B0F14;
  --bg-surface: #121821;
  --bg-subtle: #1A222E;
  --bg-elevated: rgba(18, 24, 33, 0.92);

  --text-primary: #F3F4F6;
  --text-secondary: #9CA3AF;
  --text-muted: #8492A6;

  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.16);

  --accent: #2DD4BF;
  --accent-hover: #5EEAD4;
  --accent-pop: #14B8A6;
  --accent-soft: rgba(45, 212, 191, 0.14);
  --accent-on: #042F2E;

  --hero-grad-start: #0F766E;
  --hero-grad-end: #115E59;
  --hero-text: #F0FDFA;
  --hero-muted: rgba(240, 253, 250, 0.82);
  --hero-pill-bg: rgba(45, 212, 191, 0.22);

  --success: #34D399;
  --success-soft: rgba(52, 211, 153, 0.14);
  --warning: #FBBF24;
  --warning-soft: rgba(251, 191, 36, 0.14);
  --danger: #F87171;
  --danger-soft: rgba(248, 113, 113, 0.14);
  --info: #60A5FA;
  --info-soft: rgba(96, 165, 250, 0.14);

  --shadow-sm: none;
  --shadow-card: none;
  --shadow-float: 0 24rpx 60rpx rgba(0, 0, 0, 0.45);
}
