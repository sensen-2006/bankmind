:host {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  flex-shrink: 0;
}

.help {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx !important;
  min-width: 0 !important;
  height: 48rpx;
  min-height: 48rpx;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  color: #5b726a;
  line-height: 1;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.help::after {
  border: 0;
}

.help text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(91, 114, 106, 0.45);
  border-radius: 50%;
  font-size: 20rpx;
  line-height: 1;
}

.help:active {
  opacity: 0.65;
  transform: scale(0.94);
}

.theme-dark .help {
  color: #9eb3aa !important;
}

.theme-dark .help text {
  border-color: rgba(158, 179, 170, 0.45) !important;
  color: #9eb3aa !important;
}
