:host{display:inline-block;vertical-align:middle;width:64rpx;height:64rpx}.help{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;min-height:88rpx;margin:-12rpx;background:transparent;padding:0;color:#6d867a;border:0;line-height:1;font-size:21rpx;font-weight:600}.help:after{border:0}.help text{display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;border:2rpx solid #92ab9f;border-radius:50%}.help:active{opacity:.6}
