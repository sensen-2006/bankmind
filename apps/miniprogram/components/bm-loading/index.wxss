.loading-state {
  padding: 40rpx 0;
}

.skeleton {
  padding: 28rpx;
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
}

.skeleton view {
  height: 22rpx;
  border-radius: 10rpx;
  background-color: var(--bg-subtle);
  margin: 18rpx 0;
}

.skeleton view:nth-child(2) {
  width: 78%;
}

.skeleton view:nth-child(3) {
  width: 54%;
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  margin-top: 24rpx;
}
