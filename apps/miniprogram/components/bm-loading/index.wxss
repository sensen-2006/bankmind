.loading-state { padding: 48rpx 0; }
.skeleton { padding: 24rpx; background: var(--surface, #fafbf6); border: 1rpx solid var(--line, #d7e1d4); border-radius: 12rpx; }
.skeleton view { height: 19rpx; border-radius: 6rpx; background: var(--surface-secondary, #e6eee4); margin: 14rpx 0; }
.skeleton view:nth-child(2) { width: 80%; }
.skeleton view:nth-child(3) { width: 55%; }
.loading-text { font-size: 23rpx; color: var(--muted, #617869); text-align: center; margin-top: 26rpx; }
