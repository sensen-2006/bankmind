.loading-state {
  padding: 40rpx 0;
}

.skeleton {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 12rpx 30rpx rgba(17, 42, 34, 0.05);
}

.skeleton view {
  height: 22rpx;
  border-radius: 12rpx;
  background: linear-gradient(
    90deg,
    rgba(23, 33, 31, 0.06) 25%,
    rgba(79, 209, 165, 0.14) 50%,
    rgba(23, 33, 31, 0.06) 75%
  );
  background-size: 200% 100%;
  margin: 18rpx 0;
  animation: bm-skeleton-shimmer 1.6s ease-in-out infinite;
}

.skeleton view:nth-child(2) {
  width: 78%;
}

.skeleton view:nth-child(3) {
  width: 52%;
}

.loading-text {
  font-size: 24rpx;
  color: #5b726a;
  text-align: center;
  margin-top: 24rpx;
}

.theme-dark .skeleton {
  background: rgba(16, 33, 42, 0.72) !important;
  border-color: rgba(255, 255, 255, 0.1) !important;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 12rpx 32rpx rgba(0, 0, 0, 0.32) !important;
}

.theme-dark .skeleton view {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.06) 25%,
    rgba(95, 211, 166, 0.14) 50%,
    rgba(255, 255, 255, 0.06) 75%
  ) !important;
  background-size: 200% 100% !important;
}

.theme-dark .loading-text {
  color: #9eb3aa !important;
}

@keyframes bm-skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton view {
    animation: none !important;
  }
}
