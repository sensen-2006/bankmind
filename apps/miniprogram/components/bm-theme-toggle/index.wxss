.daylight-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 14rpx 6rpx 8rpx;
  border-radius: 9999rpx;
  background-color: var(--bg-subtle);
  border: 1rpx solid var(--border-subtle);
  flex-shrink: 0;
  transition: background-color 220ms cubic-bezier(0.22, 1, 0.36, 1), border-color 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.daylight-wrap:active {
  transform: scale(0.96);
}

.daylight-track {
  position: relative;
  width: 88rpx;
  height: 46rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  transition: background 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

.daylight-track.is-light {
  background: linear-gradient(135deg, #38BDF8 0%, #7DD3FC 100%);
}

.daylight-track.is-dark {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
}

.daylight-sky {
  position: absolute;
  inset: 0;
}

.cloud {
  position: absolute;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 9999rpx;
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 240ms ease;
}

.cloud-1 {
  width: 24rpx;
  height: 10rpx;
  right: 12rpx;
  bottom: 10rpx;
}

.cloud-2 {
  width: 16rpx;
  height: 8rpx;
  right: 26rpx;
  bottom: 18rpx;
  opacity: 0.78;
}

.daylight-track.is-dark .cloud {
  transform: translateY(20rpx);
  opacity: 0;
}

.star {
  position: absolute;
  border-radius: 9999rpx;
  background-color: #E2E8F0;
  opacity: 0;
  transform: scale(0.4);
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
}

.star-1 {
  width: 6rpx;
  height: 6rpx;
  left: 16rpx;
  top: 12rpx;
}

.star-2 {
  width: 4rpx;
  height: 4rpx;
  left: 30rpx;
  top: 26rpx;
}

.star-3 {
  width: 5rpx;
  height: 5rpx;
  left: 24rpx;
  top: 10rpx;
}

.daylight-track.is-dark .star {
  opacity: 0.92;
  transform: scale(1);
}

.daylight-thumb {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 9999rpx;
  background-color: #FDE047;
  box-shadow: 0 2rpx 8rpx rgba(250, 204, 21, 0.55);
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), background-color 300ms ease, box-shadow 300ms ease;
}

.daylight-track.is-dark .daylight-thumb {
  transform: translateX(42rpx);
  background-color: #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(148, 163, 184, 0.4);
}

.crater {
  position: absolute;
  border-radius: 9999rpx;
  background-color: rgba(100, 116, 139, 0.35);
  opacity: 0;
  transition: opacity 260ms ease;
}

.crater-1 {
  width: 10rpx;
  height: 10rpx;
  left: 8rpx;
  top: 10rpx;
}

.crater-2 {
  width: 6rpx;
  height: 6rpx;
  right: 8rpx;
  bottom: 9rpx;
}

.daylight-track.is-dark .crater {
  opacity: 1;
}

.daylight-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
}

.daylight-wrap.is-compact {
  padding: 4rpx 12rpx 4rpx 6rpx;
  gap: 8rpx;
}
