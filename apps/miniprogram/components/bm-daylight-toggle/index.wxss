.daylight-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 18rpx 8rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(18px) saturate(170%);
  -webkit-backdrop-filter: blur(18px) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 6rpx 18rpx rgba(17, 42, 34, 0.06);
  transition: background 240ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 240ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 140ms cubic-bezier(0.22, 1, 0.36, 1);
}

.daylight-btn:active {
  transform: scale(0.96);
}

.daylight-btn.is-dark {
  background: rgba(16, 33, 42, 0.82);
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08), 0 6rpx 18rpx rgba(0, 0, 0, 0.32);
}

.daylight-btn.is-compact {
  padding: 6rpx 14rpx 6rpx 8rpx;
  gap: 10rpx;
}

.daylight-track {
  position: relative;
  width: 78rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7dd3fc 0%, #bae6fd 58%, #fef3c7 100%);
  box-shadow: inset 0 2rpx 5rpx rgba(15, 23, 42, 0.14);
  overflow: hidden;
  transition: background 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.daylight-btn.is-dark .daylight-track {
  background: linear-gradient(135deg, #0b1e28 0%, #173440 68%, #224752 100%);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.48);
}

.daylight-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fffdf5;
  box-shadow: 0 3rpx 8rpx rgba(15, 23, 42, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
    background 260ms ease,
    box-shadow 260ms ease;
}

.daylight-btn.is-dark .daylight-thumb {
  transform: translateX(36rpx);
  background: #f5e6be;
  box-shadow: 0 0 14rpx rgba(245, 230, 190, 0.52);
}

.daylight-orb {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #f59e0b;
  transition: background 260ms ease, box-shadow 260ms ease, transform 260ms ease;
}

.daylight-btn.is-dark .daylight-orb {
  background: transparent;
  box-shadow: inset 6rpx -3rpx 0 0 #162e36;
}

.daylight-clouds,
.daylight-stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  transition: opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.daylight-clouds {
  opacity: 0.92;
  transform: translateY(0);
}

.daylight-btn.is-dark .daylight-clouds {
  opacity: 0;
  transform: translateY(6rpx);
}

.cloud {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
}

.cloud.c1 {
  width: 20rpx;
  height: 7rpx;
  right: 10rpx;
  bottom: 9rpx;
}

.cloud.c2 {
  width: 13rpx;
  height: 6rpx;
  right: 18rpx;
  top: 10rpx;
}

.daylight-stars {
  opacity: 0;
  transform: translateY(-6rpx);
}

.daylight-btn.is-dark .daylight-stars {
  opacity: 0.96;
  transform: translateY(0);
}

.star {
  position: absolute;
  border-radius: 50%;
  background: #f6e7be;
}

.star.s1 {
  width: 5rpx;
  height: 5rpx;
  left: 14rpx;
  top: 11rpx;
}

.star.s2 {
  width: 4rpx;
  height: 4rpx;
  left: 24rpx;
  bottom: 12rpx;
}

.daylight-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #17211f;
  line-height: 1;
}

.daylight-btn.is-dark .daylight-text {
  color: #f3eedc;
}

@media (prefers-reduced-motion: reduce) {
  .daylight-btn,
  .daylight-track,
  .daylight-thumb,
  .daylight-orb,
  .daylight-clouds,
  .daylight-stars {
    transition: none !important;
  }
}
