.login-heading {
  color: var(--ink);
  font-size: 45rpx;
  font-weight: 700;
  margin: 0 0 26rpx;
}

.login-accounts {
  border-top: 1rpx solid var(--line);
  margin-top: 28rpx;
  padding-top: 6rpx;
}

.account-choices {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.login .account-choice {
  min-height: 76rpx;
  margin: 0;
  padding: 10rpx 8rpx;
  font-size: 26rpx;
}

.login .account-choice.selected {
  color: var(--blue-dark);
  border-color: var(--blue);
  background: var(--surface-secondary);
}

.login .login-retry {
  display: block;
  width: auto;
  margin: 10rpx 0 0;
  padding: 0;
}
