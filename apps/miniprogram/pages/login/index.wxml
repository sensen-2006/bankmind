<view class="page login theme-{{theme}}">
  <view class="mobile-brand bm-enter stagger-1">
    <view class="brand-link"><view /><view /></view>
    <text>BankMind</text>
    <bm-daylight-toggle theme="{{theme}}" compact="{{true}}" bindchange="onThemeChange" />
  </view>

  <view class="title bm-enter stagger-1">
    <view>让每一笔，</view>
    <view>清晰相合。</view>
  </view>
  <view class="sub bm-enter stagger-1">银账智核 · 移动工作空间</view>

  <view class="notice error" wx:if="{{error}}">{{error}}</view>

  <view class="login-form bm-enter stagger-2">
    <view class="form-label">企业账号</view>
    <input data-field="username" value="{{username}}" placeholder="请输入企业账号（如 reviewer）" bindinput="input" aria-label="企业账号" />
    <view class="form-label">密码</view>
    <input data-field="password" value="{{password}}" password placeholder="请输入账号密码" bindinput="input" aria-label="密码" />
    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">
      <text>进入工作空间</text>
      <text>→</text>
    </button>
    <button class="secondary" wx:if="{{mode === 'wechat'}}" disabled="{{busy}}" bindtap="wechat">微信身份登录</button>
  </view>

  <view class="login-note bm-enter stagger-3" wx:if="{{mode !== 'wechat'}}">
    <text>企业账号登录</text>
    <bm-help label="登录说明" text="请使用企业管理员分配的体验账号与密码登录（如 reviewer / accountant / auditor）。" />
  </view>
  <view class="login-note bm-enter stagger-3" wx:else>
    <text>微信登录需先绑定企业身份</text>
    <bm-help label="绑定企业身份" text="使用企业账号登录后，可在个人中心绑定当前微信。授权账户和角色由企业服务器校验。" />
  </view>
</view>
