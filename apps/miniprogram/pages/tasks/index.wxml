<view class="page theme-{{theme}}">
  <view class="page-title-row bm-enter stagger-1">
    <view class="title">对账任务</view>
    <button wx:if="{{canWork}}" class="primary create-task-btn" bindtap="toggleCreate">
      {{showCreate ? '收起' : '＋ 新建任务'}}
    </button>
  </view>

  <view wx:if="{{canWork && showCreate}}" class="card create-task-card bm-enter stagger-1">
    <view class="card-title">新建对账任务</view>
    <view class="form-label" style="margin-top: 8rpx;">任务名称</view>
    <input
      placeholder="如：2026年11月 · 基本户月度对账"
      value="{{form.name}}"
      data-field="name"
      bindinput="onFormInput"
      disabled="{{creating}}"
    />

    <view class="form-label">授权银行账户</view>
    <picker
      mode="selector"
      range="{{accountLabels}}"
      value="{{form.accountIndex}}"
      bindchange="onAccountPick"
      disabled="{{creating || !accounts.length}}"
    >
      <view class="picker-pill">
        <text>{{accountLabels[form.accountIndex] || '暂无授权账户'}}</text>
        <text class="muted">▾</text>
      </view>
    </picker>

    <view class="date-range-row">
      <view class="date-col">
        <view class="form-label">开始日期</view>
        <picker mode="date" value="{{form.start_date}}" data-field="start_date" bindchange="onDatePick" disabled="{{creating}}">
          <view class="picker-pill">
            <text>{{form.start_date}}</text>
            <text class="muted">▾</text>
          </view>
        </picker>
      </view>
      <view class="date-col">
        <view class="form-label">结束日期</view>
        <picker mode="date" value="{{form.end_date}}" data-field="end_date" bindchange="onDatePick" disabled="{{creating}}">
          <view class="picker-pill">
            <text>{{form.end_date}}</text>
            <text class="muted">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="actions" style="margin-top: 22rpx;">
      <button class="secondary" style="margin-top: 0;" disabled="{{creating}}" bindtap="toggleCreate">取消</button>
      <button class="primary" style="margin-top: 0;" loading="{{creating}}" disabled="{{creating || !accounts.length}}" bindtap="submitCreate">创建并导入</button>
    </view>
  </view>

  <view class="search-box bm-enter stagger-1">
    <view class="search-symbol" />
    <input placeholder="搜索任务或银行账户" value="{{query}}" bindinput="search" aria-label="搜索对账任务" />
  </view>

  <scroll-view scroll-x enable-flex class="filter-scroll bm-enter stagger-2">
    <view class="chip-list">
      <button class="chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</button>
      <button class="chip {{status === 'REVIEW' ? 'active' : ''}}" data-status="REVIEW" bindtap="filter">待复核</button>
      <button class="chip {{status === 'DRAFT' ? 'active' : ''}}" data-status="DRAFT" bindtap="filter">草稿</button>
      <button class="chip {{status === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="filter">已完成</button>
    </view>
  </scroll-view>

  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 轻触重试</view>
  <bm-loading wx:if="{{loading}}" text="正在读取对账任务" />

  <view wx:if="{{!loading && !filteredTasks.length}}" class="empty">
    <view class="empty-symbol">≡</view>
    <view>{{tasks.length ? '没有符合筛选的任务' : '还没有对账任务'}}</view>
    <view class="muted">{{tasks.length ? '试试其他状态或关键词。' : (canWork ? '点击右上角「＋ 新建任务」即可开始对账。' : '请在电脑端创建任务。')}}</view>
  </view>

  <view class="list-count" wx:if="{{!loading}}">{{filteredTasks.length}} 个任务</view>

  <view
    class="card task-card bm-enter stagger-3 {{item.status === 'COMPLETED' ? 'status-completed' : 'status-review'}}"
    wx:for="{{filteredTasks}}"
    wx:key="id"
  >
    <view class="row">
      <view class="task-name">{{item.name}}</view>
      <text class="pill {{item.status === 'COMPLETED' ? 'success' : 'amber'}}">{{item.statusLabel}}</text>
    </view>
    <view class="muted task-account">{{item.account_name}}</view>
    <view class="task-period">{{item.start_date}} — {{item.end_date}}</view>

    <view class="row progress-caption">
      <text>已确认覆盖</text>
      <text>{{item.confirmedPct}}%</text>
    </view>
    <view class="bento-striped-bar">
      <view class="bar-certain liquid-bar" wx:if="{{item.confirmedPct > 0}}" style="width: {{item.confirmedPct}}%;" />
      <view class="bar-suggested liquid-bar" wx:if="{{item.pendingPct > 0}}" style="width: {{item.pendingPct}}%;" />
    </view>

    <view class="row">
      <text class="muted">银行 {{item.bank.matched}} / {{item.bank.valid}} · 企业账簿 {{item.book.matched}} / {{item.book.valid}}</text>
      <text class="muted">有效行</text>
    </view>

    <view class="task-next">
      <view>
        <text class="pill {{item.summary.pending_matches ? 'amber' : ''}}">{{item.summary.pending_matches}} 条待确认</text>
        <text class="pill {{item.summary.open_cases ? 'error' : ''}}">{{item.summary.open_cases}} 条异常</text>
      </view>
      <view class="actions">
        <button wx:if="{{canWork}}" class="secondary" data-id="{{item.id}}" bindtap="openWork">导入与作业</button>
        <button class="secondary" data-id="{{item.id}}" bindtap="alerts">异常详情</button>
        <button class="primary" data-id="{{item.id}}" bindtap="matches">查看匹配证据 →</button>
      </view>
    </view>
  </view>
</view>
