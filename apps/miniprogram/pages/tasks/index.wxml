<view class="workspace-mode workspace-mode-{{workspaceMode}}">
<view class="page"><view class="title">对账任务</view><view class="search-box"><view class="search-symbol"/><input placeholder="搜索任务或银行账户" value="{{query}}" bindinput="search" aria-label="搜索对账任务"/></view><scroll-view scroll-x class="filter-scroll"><view class="chip-list"><button class="chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</button><button class="chip {{status === 'REVIEW' ? 'active' : ''}}" data-status="REVIEW" bindtap="filter">待复核</button><button class="chip {{status === 'DRAFT' ? 'active' : ''}}" data-status="DRAFT" bindtap="filter">草稿</button><button class="chip {{status === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="filter">已完成</button></view></scroll-view><view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 轻触重试</view><bm-loading wx:if="{{loading}}" text="正在读取对账任务"/><view wx:if="{{!loading && !filteredTasks.length}}" class="empty"><view class="empty-symbol">≡</view><view>{{tasks.length ? '没有符合筛选的任务' : '还没有对账任务'}}</view><view class="muted">{{tasks.length ? '试试其他状态或关键词。' : '请在网页创建任务。'}}</view></view><view class="list-count" wx:if="{{!loading}}">{{filteredTasks.length}} 个任务</view><view class="card task-card" wx:for="{{filteredTasks}}" wx:key="id"><view class="row"><view class="task-name">{{item.name}}</view><text class="pill {{item.status === 'COMPLETED' ? 'success' : 'amber'}}">{{item.statusLabel}}</text></view><view class="muted task-account">{{item.account_name}}</view><view class="task-period">{{item.start_date}} — {{item.end_date}}</view><view class="row progress-caption"><text>已确认覆盖</text><text>{{item.confirmedPct}}%</text></view><view class="progress"><view style="width:{{item.confirmedPct}}%"/></view><view class="row"><text class="muted">银行 {{item.bank.matched}} / {{item.bank.valid}} · 账面 {{item.book.matched}} / {{item.book.valid}}</text><text class="muted">有效行</text></view><view class="task-next"><view><text class="pill {{item.summary.pending_matches ? 'amber' : ''}}">{{item.summary.pending_matches}} 条待确认</text><text class="pill {{item.summary.open_cases ? 'error' : ''}}">{{item.summary.open_cases}} 条异常</text></view><view class="actions"><button wx:if="{{canWork}}" class="secondary" data-id="{{item.id}}" bindtap="openWork">导入与作业</button><button class="secondary" data-id="{{item.id}}" bindtap="alerts">异常详情</button><button class="primary" data-id="{{item.id}}" bindtap="matches">匹配证据 →</button></view></view></view></view>
</view>
