<view class="page theme-{{theme}}">
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 轻触重试</view>
  <bm-loading wx:if="{{loading && !transaction && !match && !items.length}}" text="正在读取证据"/>

  <block wx:if="{{transaction}}">
    <view class="card">
      <view class="row">
        <text class="pill">{{transaction.side === 'BANK' ? '银行流水' : '企业账簿'}}</text>
        <text class="money">{{transaction.displayAmount}}</text>
      </view>
      <view class="card-heading">{{transaction.source.filename}}</view>
      <view class="muted" style="margin-top:6rpx">{{transaction.source.sheet || 'CSV'}} · 原始第 {{transaction.row_no}} 行</view>
      <view class="id-chip" data-value="{{transaction.source.sha256}}" bindtap="copyText">
        <text>文件校验 {{transaction.shortSha}}</text>
        <text class="id-chip-copy">复制</text>
      </view>
      <view class="divider"/>
      <view class="kv" wx:for="{{rawFields}}" wx:key="key">
        <text>{{item.key}}</text>
        <text>{{item.value || '（空）'}}</text>
      </view>
    </view>
  </block>

  <block wx:if="{{match}}">
    <view class="card">
      <view class="row">
        <text class="pill">{{match.methodLabel}}</text>
        <text class="pill {{match.status === 'APPROVED' || match.status === 'DETERMINISTIC' ? 'success' : 'amber'}}">{{match.statusLabel}}</text>
      </view>

      <view class="match-relationship">
        <view>
          <view class="value">{{match.bank.length}}</view>
          <view class="muted">银行流水</view>
        </view>
        <text class="match-connector">↔</text>
        <view>
          <view class="value">{{match.book.length}}</view>
          <view class="muted">企业账簿</view>
        </view>
      </view>

      <view class="evidence-metrics">
        <view class="evidence-metric-box">
          <view class="metric-value">{{match.evidence.amount_delta}}</view>
          <view class="muted" style="margin-top:6rpx">金额差</view>
        </view>
        <view class="evidence-metric-box">
          <view class="metric-value">{{match.evidence.date_delta_days}} 天</view>
          <view class="muted" style="margin-top:6rpx">日期差</view>
        </view>
        <view class="evidence-metric-box">
          <view class="metric-value">{{match.score}}</view>
          <view class="metric-label-row">
            <text class="muted">规则评分</text>
            <bm-help label="规则评分" text="评分来自匹配规则，不是统计概率。确认前请核对原始交易和匹配依据。"/>
          </view>
        </view>
      </view>

      <view class="id-chip" data-value="{{match.id}}" bindtap="copyText">
        <text>匹配编号 {{match.shortId}} · v{{match.version}}</text>
        <text class="id-chip-copy">复制</text>
      </view>
      <view class="note">{{match.evidence.predicates}}</view>
    </view>

    <view class="section">银行流水（{{match.bank.length}} 笔）</view>
    <view class="card record-card" wx:for="{{match.bank}}" wx:key="id">
      <view class="row">
        <text class="task-name">{{item.counterparty || '未提供'}}</text>
        <text class="money">{{item.displayAmount}}</text>
      </view>
      <view class="kv"><text>日期</text><text>{{item.date}}</text></view>
      <view class="kv"><text>摘要</text><text>{{item.description}}</text></view>
      <view class="evidence-id" data-id="{{item.id}}" bindtap="source">查看原始第 {{item.row_no}} 行 →</view>
    </view>

    <view class="section">企业账簿（{{match.book.length}} 笔）</view>
    <view class="card record-card book-record" wx:for="{{match.book}}" wx:key="id">
      <view class="row">
        <text class="task-name">{{item.counterparty || '未提供'}}</text>
        <text class="money">{{item.displayAmount}}</text>
      </view>
      <view class="kv"><text>日期</text><text>{{item.date}}</text></view>
      <view class="kv"><text>摘要</text><text>{{item.description}}</text></view>
      <view class="evidence-id" data-id="{{item.id}}" bindtap="source">查看原始第 {{item.row_no}} 行 →</view>
    </view>

    <view class="card" wx:if="{{canApprove}}">
      <view class="card-title">独立复核意见</view>
      <textarea
        placeholder="至少4字，写明复核依据"
        placeholder-class="input-placeholder"
        value="{{reason}}"
        bindinput="input"
      />
      <button class="primary" disabled="{{busy}}" loading="{{busy}}" data-action="APPROVE" bindtap="decide">{{match.status === 'REVERSAL_PENDING' ? '批准撤销' : '确认匹配'}}</button>
      <view class="actions">
        <button class="secondary danger" disabled="{{busy}}" data-action="REJECT" bindtap="decide">拒绝</button>
        <button class="secondary" disabled="{{busy}}" data-action="REQUEST_EVIDENCE" bindtap="decide">要求补充材料</button>
      </view>
    </view>
    <view class="notice" wx:else>当前状态或角色不能审批；本人提交需由另一位授权人员复核。</view>
  </block>

  <block wx:if="{{taskId && !id}}">
    <view class="empty" wx:if="{{!loading && !items.length}}">
      <view class="empty-symbol">≡</view>
      <view>尚无匹配结果</view>
      <view class="muted">请先在电脑端或数据导入页完成导入并执行匹配。</view>
    </view>
    <view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="row">
        <text class="task-name">{{item.first.counterparty || '未提供'}}</text>
        <text class="pill {{item.status === 'APPROVED' || item.status === 'DETERMINISTIC' ? 'success' : 'amber'}}">{{item.statusLabel}}</text>
      </view>
      <view class="review-amount">{{item.displayAmount}}</view>
      <view class="task-bottom">
        <text>{{item.methodLabel}} · {{item.book.length}} 笔企业账簿</text>
        <text>核对证据 →</text>
      </view>
    </view>
    <view class="actions" wx:if="{{total > 25}}">
      <button class="secondary" disabled="{{page <= 1}}" bindtap="prev">上一页</button>
      <button class="secondary" disabled="{{page * 25 >= total}}" bindtap="next">下一页</button>
    </view>
  </block>
</view>
