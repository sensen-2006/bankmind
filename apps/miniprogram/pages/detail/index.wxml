<view class="workspace-mode workspace-mode-{{workspaceMode}}">
<view class="page"><view class="title">异常详情</view><view wx:if="{{error}}" class="notice error">{{error}}</view><bm-loading wx:if="{{loading}}" text="正在读取证据"/><block wx:if="{{detail}}"><view class="card"><view class="row"><text class="pill">{{detail.kindLabel}}</text><text class="pill amber">{{detail.statusLabel}}</text></view><view class="section">{{detail.title}}</view><view class="mono" style="margin-top:20rpx">{{detail.id}} · v{{detail.version}}</view></view><view class="section">交易证据</view><view class="card" wx:for="{{detail.transactions}}" wx:key="id"><view class="row"><text class="pill">{{item.side === 'BANK' ? '银行流水' : '企业账面'}}</text><text class="money">{{item.displayAmount}}</text></view><view class="kv"><text>对方</text><text>{{item.counterparty || '未提供'}}</text></view><view class="kv"><text>日期</text><text>{{item.date}}</text></view><view class="kv"><text>摘要</text><text>{{item.description}}</text></view><view class="evidence-id" data-id="{{item.id}}" bindtap="source">原行 {{item.row_no}} · {{item.id}} →</view></view><view wx:if="{{detail.candidates.length}}" class="collapse-toggle" bindtap="toggleCandidates" aria-role="button"><text>相关候选 · {{detail.candidates.length}} 笔（未确认）</text><text>{{expandedCandidates ? '收起 −' : '展开 ＋'}}</text></view><block wx:if="{{expandedCandidates}}"><view class="card" wx:for="{{detail.candidates}}" wx:key="id" data-id="{{item.id}}" bindtap="source"><view class="row"><text>{{item.counterparty || '未提供'}}</text><text class="money">{{item.displayAmount}}</text></view><view class="kv"><text>{{item.date}}</text><text>原行 {{item.row_no}} →</text></view></view></block><view class="card material-block"><view class="section-with-help"><view class="card-title">证据材料</view><bm-help label="材料核验" text="必要材料被退回或尚未核验会阻止结案。移动端可上传 PDF 或 TXT。核验前请先查看原件。"/></view><view wx:if="{{!attachments.length}}" class="muted">尚无材料。</view><view class="note" wx:for="{{attachments}}" wx:key="id"><view>{{item.filename}} · {{item.statusLabel}}</view><view class="muted">{{item.current_evidence ? (item.necessary ? '当前必要材料' : '补充材料') : '已替换历史件'}} · v{{item.version}}</view><view class="mono">SHA256 {{item.sha256}}</view><view>{{item.note}}</view><button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="attachment">查看原件</button><view wx:if="{{item.canVerify}}" class="actions"><button class="secondary danger" disabled="{{busy}}" data-id="{{item.id}}" data-action="REJECT" bindtap="verifyAttachment">退回材料</button><button class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="APPROVE" bindtap="verifyAttachment">核验通过</button></view></view>
  <block wx:if="{{user.role !== 'Auditor' && detail.status !== 'CLOSED'}}">
    <button class="secondary" disabled="{{busy}}" bindtap="chooseMaterial">选择 PDF / TXT 材料</button>
    <view wx:if="{{attachmentFile}}" class="note">
      <view>{{attachmentFile.name}}</view>
      <view class="form-label">材料说明</view>
      <input value="{{materialNote}}" bindinput="materialNote" placeholder="说明材料与异常的关系"/>
      <button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="uploadMaterial">提交材料</button>
    </view>
  </block>
<button class="secondary" bindtap="handoff">交接至网页端</button></view><view class="card ai"><view class="card-title">调查建议</view><view class="muted">{{detail.analysis.label || '尚未生成建议'}}</view><block wx:if="{{detail.analysis.hypotheses}}"><view wx:for="{{detail.analysis.hypotheses}}" wx:key="reason" class="note"><view>{{item.reason}}</view><view style="margin-top:16rpx">反证/限制：{{item.counter_evidence}}</view><view>调查步骤：{{item.verification_step}}</view><view class="evidence-id" wx:for="{{item.evidence_ids}}" wx:for-item="eid" wx:key="*this" data-id="{{eid}}" bindtap="source">证据 {{eid}} →</view></view><view class="notice">{{detail.analysis.proposed_action}}</view></block>
    <view wx:if="{{detail.analysis.attempted_provider}}" class="muted">
      {{detail.analysis.status === 'FALLBACK' ? '已回退到本地 Mock' : detail.analysis.attempted_model}}
    </view>
    <view class="notice error" wx:if="{{aiError}}">{{aiError}}</view>
    <block wx:if="{{user.role !== 'Auditor' && detail.status !== 'CLOSED' && aiChoices.length}}">
      <view class="form-label">调查模型</view>
      <picker range="{{aiChoices}}" range-key="label" value="{{aiIndex}}" disabled="{{busy}}" bindchange="chooseProvider">
        <view class="ai-model">{{aiChoices[aiIndex].label}} ▾</view>
      </picker>
      <button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="investigate">生成调查建议</button>
    </block>
</view><view class="card"><view class="section-with-help"><view class="card-title">处理与复核</view><bm-help label="独立复核" text="先核对原行和材料，再填写处理依据。本人提交须由他人复核，审批结果与网页端同步。"/></view><view class="note" wx:if="{{detail.note}}">最近意见：{{detail.note}}</view><block wx:if="{{user.role !== 'Auditor'}}"><view class="form-label">处理意见 / 补充材料说明</view><textarea value="{{reason}}" bindinput="input" placeholder="至少4字，说明检查了什么证据"/><block wx:if="{{detail.status !== 'CLOSED'}}"><view class="form-label">人工处理分类</view><picker range="{{resolutions}}" value="{{resolution}}" bindchange="resolution">{{resolutions[resolution]}} ▾</picker><view class="actions"><button class="secondary" data-action="NOTE" disabled="{{busy}}" bindtap="save">保存备注</button><button class="primary" data-action="SUBMIT" disabled="{{busy}}" bindtap="save">提交独立复核</button></view></block><block wx:if="{{canApprove}}"><button class="primary" data-action="APPROVE" disabled="{{busy}}" bindtap="decide">确认处理并关闭异常</button><view class="actions"><button class="secondary danger" data-action="RETURN" disabled="{{busy}}" bindtap="decide">退回调查</button><button class="secondary" data-action="REQUEST_EVIDENCE" disabled="{{busy}}" bindtap="decide">要求补充材料</button></view></block></block></view><view class="card"><view class="collapse-toggle" bindtap="toggleHistory" aria-role="button"><text>处理记录 · {{detail.events.length}} 条</text><text>{{expandedHistory ? '收起 −' : '展开 ＋'}}</text></view><view wx:if="{{!detail.events.length}}" class="muted">暂无人工处理记录。</view><view wx:if="{{expandedHistory}}" wx:for="{{detail.events}}" wx:key="id" class="history-item"><view>{{item.action}} · {{item.before}} → {{item.after}}</view><view class="muted">{{item.created_at}}</view><view>{{item.reason}}</view></view></view></block></view>
</view>
