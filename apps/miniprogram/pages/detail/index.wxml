<view class="page theme-{{theme}}">
  <view wx:if="{{error}}" class="notice error" bindtap="load">{{error}} · 轻触重试</view>
  <bm-loading wx:if="{{loading && !detail}}" text="正在读取证据"/>

  <block wx:if="{{detail}}">
    <view class="card">
      <view class="row">
        <text class="pill">{{detail.kindLabel}}</text>
        <text class="pill {{detail.status === 'CLOSED' ? 'success' : 'amber'}}">{{detail.statusLabel}}</text>
      </view>
      <view class="card-heading">{{detail.title}}</view>
      <view class="id-chip" data-value="{{detail.id}}" bindtap="copyText">
        <text>编号 {{detail.shortId}} · v{{detail.version}}</text>
        <text class="id-chip-copy">复制</text>
      </view>
    </view>

    <view class="section">交易证据</view>
    <view class="card" wx:for="{{detail.transactions}}" wx:key="id">
      <view class="row">
        <text class="pill">{{item.side === 'BANK' ? '银行流水' : '企业账簿'}}</text>
        <text class="money">{{item.displayAmount}}</text>
      </view>
      <view class="kv"><text>对方</text><text>{{item.counterparty || '未提供'}}</text></view>
      <view class="kv"><text>日期</text><text>{{item.date}}</text></view>
      <view class="kv"><text>摘要</text><text>{{item.description}}</text></view>
      <view class="evidence-id" data-id="{{item.id}}" bindtap="source">查看原始第 {{item.row_no}} 行（{{item.shortId}}）→</view>
    </view>

    <view wx:if="{{detail.candidates.length}}" class="collapse-toggle" bindtap="toggleCandidates" aria-role="button">
      <text>相关候选 · {{detail.candidates.length}} 笔（未确认）</text>
      <text>{{expandedCandidates ? '收起 −' : '展开 ＋'}}</text>
    </view>
    <block wx:if="{{expandedCandidates}}">
      <view class="card" wx:for="{{detail.candidates}}" wx:key="id" data-id="{{item.id}}" bindtap="source">
        <view class="row">
          <text class="task-name">{{item.counterparty || '未提供'}}</text>
          <text class="money">{{item.displayAmount}}</text>
        </view>
        <view class="kv"><text>{{item.date}}</text><text>原始第 {{item.row_no}} 行 →</text></view>
      </view>
    </block>

    <view class="card material-block">
      <view class="section-with-help">
        <view class="card-title">证据材料</view>
        <bm-help label="材料核验" text="必要材料被退回或尚未核验会阻止结案。上传、替换和范围豁免请在电脑端完成。核验前请先查看原件。"/>
      </view>
      <view wx:if="{{!attachments.length}}" class="muted">尚无材料，请在电脑端补充。</view>
      <view class="note" wx:for="{{attachments}}" wx:key="id">
        <view class="row">
          <text class="note-title">{{item.filename}}</text>
          <text class="pill {{item.status === 'VERIFIED' ? 'success' : (item.status === 'REJECTED' ? 'error' : 'amber')}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted" style="margin-top:6rpx">{{item.current_evidence ? (item.necessary ? '当前必要材料' : '补充材料') : '已替换历史件'}} · v{{item.version}}</view>
        <view class="id-chip" data-value="{{item.sha256}}" bindtap="copyText">
          <text>文件校验 {{item.shortSha}}</text>
          <text class="id-chip-copy">复制</text>
        </view>
        <view wx:if="{{item.note}}" style="margin-top:10rpx">{{item.note}}</view>
        <button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="attachment">查看原件</button>

        <view wx:if="{{item.canVerify}}" class="actions">
          <button class="secondary danger" disabled="{{busy}}" data-id="{{item.id}}" data-action="REJECT" bindtap="verifyAttachment">退回材料</button>
          <button class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="APPROVE" bindtap="verifyAttachment">核验通过</button>
        </view>

        <view wx:if="{{verifyDraftId === item.id}}" style="margin-top:16rpx">
          <view class="form-label" style="margin-top:0">请填写{{verifyDraftAction === 'APPROVE' ? '核验通过' : '退回材料'}}意见（至少4字）</view>
          <textarea
            value="{{verifyDraftReason}}"
            bindinput="verifyDraftInput"
            placeholder="例如：已核对原件金额与交易日期，与流水一致"
            placeholder-class="input-placeholder"
          />
          <view class="actions">
            <button class="secondary" disabled="{{busy}}" bindtap="cancelVerifyDraft">取消</button>
            <button class="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="{{verifyDraftAction}}" bindtap="verifyAttachment">确认提交</button>
          </view>
        </view>
      </view>
      <button class="secondary" bindtap="handoff">复制交接信息至电脑端</button>
    </view>

    <view class="card ai">
      <view class="card-title">调查建议</view>
      <view class="muted">{{detail.analysis.label || '尚未生成建议'}}</view>
      <block wx:if="{{detail.analysis.hypotheses}}">
        <view wx:for="{{detail.analysis.hypotheses}}" wx:key="reason" class="note">
          <view class="note-title">{{item.reason}}</view>
          <view class="muted" style="margin-top:10rpx">反证 / 限制：{{item.counter_evidence}}</view>
          <view style="margin-top:6rpx">建议步骤：{{item.verification_step}}</view>
          <view class="evidence-id" wx:for="{{item.evidence_ids}}" wx:for-item="eid" wx:key="*this" data-id="{{eid}}" bindtap="source">查看关联证据 →</view>
        </view>
        <view class="notice">{{detail.analysis.proposed_action}}</view>
      </block>
      <view class="ai-model">
        <text>{{aiConfig.mode === 'live' && aiConfig.external_enabled ? '智能引擎 · 增强版' : '本地规则辅助'}}</text>
        <bm-help label="调查建议" text="{{'服务：' + (aiConfig.provider_host || '本地规则引擎') + '；模型：' + (aiConfig.model || '标准规则') + '。建议需人工核验，外部调用前会再次确认。'}}"/>
      </view>
      <button wx:if="{{user.role !== 'Auditor' && detail.status !== 'CLOSED'}}" class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="investigate">生成调查建议</button>
    </view>

    <view class="card">
      <view class="section-with-help">
        <view class="card-title">处理与复核</view>
        <bm-help label="独立复核" text="先核对原行和材料，再填写处理依据。本人提交须由他人复核，审批结果与电脑端实时同步。"/>
      </view>
      <view class="note" wx:if="{{detail.note}}">最近意见：{{detail.note}}</view>
      <block wx:if="{{user.role !== 'Auditor'}}">
        <view class="form-label">处理意见 / 补充材料说明</view>
        <textarea
          value="{{reason}}"
          bindinput="input"
          placeholder="至少4字，说明核对了哪些交易证据"
          placeholder-class="input-placeholder"
        />
        <block wx:if="{{detail.status !== 'CLOSED'}}">
          <view class="form-label">人工处理分类</view>
          <picker range="{{resolutions}}" value="{{resolution}}" bindchange="resolution">
            <view class="picker-box">
              <text class="picker-label">分类</text>
              <text class="picker-value">{{resolutions[resolution]}} ▾</text>
            </view>
          </picker>
          <view class="actions">
            <button class="secondary" data-action="NOTE" disabled="{{busy}}" bindtap="save">保存备注</button>
            <button class="primary" data-action="SUBMIT" disabled="{{busy}}" bindtap="save">提交独立复核</button>
          </view>
        </block>
        <block wx:if="{{canApprove}}">
          <button class="primary" data-action="APPROVE" disabled="{{busy}}" bindtap="decide">确认处理并关闭异常</button>
          <view class="actions">
            <button class="secondary danger" data-action="RETURN" disabled="{{busy}}" bindtap="decide">退回调查</button>
            <button class="secondary" data-action="REQUEST_EVIDENCE" disabled="{{busy}}" bindtap="decide">要求补充材料</button>
          </view>
        </block>
      </block>
    </view>

    <view class="card">
      <view class="collapse-toggle" bindtap="toggleHistory" aria-role="button">
        <text>处理记录 · {{detail.events.length}} 条</text>
        <text>{{expandedHistory ? '收起 −' : '展开 ＋'}}</text>
      </view>
      <view wx:if="{{!detail.events.length}}" class="muted" style="margin-top:12rpx">暂无人工处理记录。</view>
      <view wx:if="{{expandedHistory}}" wx:for="{{detail.events}}" wx:key="id" class="history-item">
        <view class="history-action">{{item.actionLabel}} · {{item.beforeLabel}} → {{item.afterLabel}}</view>
        <view class="muted" style="margin:4rpx 0">{{item.created_at}}</view>
        <view>{{item.reason}}</view>
      </view>
    </view>
  </block>
</view>
