.workspace-entrances {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}
.workspace-name { font-size: 29rpx; font-weight: 650; }
.workspace-entrances .daylight-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 8rpx 18rpx 8rpx 8rpx;
  flex-shrink: 0;
  border: 1rpx solid #c7a97864;
  border-radius: 60rpx;
  background: #263741;
  color: #f5e7c8;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  transition: background-color 300ms, color 300ms, border-color 300ms;
}
.daylight-switch::after { border: 0; }
.daylight-switch.is-day {
  border-color: #3f6b4c44;
  background: #f1f5e9;
  color: #224b39;
}
.daylight-switch.daylight-pressed { opacity: .8; }
.daylight-track {
  position: relative;
  box-sizing: border-box;
  width: 146rpx;
  height: 64rpx;
  overflow: hidden;
  border: 2rpx solid #ead4a690;
  border-radius: 36rpx;
  background: #192e40;
  isolation: isolate;
}
.daylight-track image, .daylight-shade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.daylight-night { filter: brightness(.74) saturate(1.15); }
.daylight-day {
  opacity: 0;
  transition: opacity 350ms ease;
}
.is-day .daylight-day { opacity: 1; }
.daylight-shade { box-shadow: inset 0 2rpx 10rpx #0b202dbb; }
.daylight-lens {
  position: absolute;
  top: 5rpx;
  left: 6rpx;
  box-sizing: border-box;
  width: 50rpx;
  height: 50rpx;
  border: 1rpx solid #fff5d8d9;
  border-radius: 50%;
  background: radial-gradient(circle at 31% 20%, #ffffffab, #f4efe447 47%, #f7dd9660 100%);
  box-shadow: 0 3rpx 10rpx #10202d9e, inset 0 -5rpx 8rpx #fffff044;
  transform: translateX(79rpx);
  transition: transform 360ms cubic-bezier(.24,.8,.2,1);
}
.is-day .daylight-lens { transform: translateX(0); }
.daylight-moon, .daylight-sun {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 23rpx;
  height: 23rpx;
  border-radius: 50%;
  transition: opacity 220ms ease;
}
.daylight-moon {
  transform: translate(3rpx, -2rpx) rotate(-24deg);
  box-shadow: -5rpx 4rpx 0 #fff1b9;
}
.daylight-sun {
  box-sizing: border-box;
  background: #ffdf8a;
  border: 1rpx solid #fff2bf;
  box-shadow: 0 0 10rpx #ffec9b;
  opacity: 0;
}
.is-day .daylight-moon { opacity: 0; }
.is-day .daylight-sun { opacity: 1; }
@media (prefers-reduced-motion: reduce) {
  .workspace-entrances .daylight-switch, .daylight-day, .daylight-lens, .daylight-moon, .daylight-sun {
    transition: none;
  }
}
.classic-hero {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  border-radius: 32rpx;
  background: #1e4233;
  color: #f9f7e7;
  min-height: 225rpx;
}
.classic-hero image, .classic-hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.classic-hero-shade {
  background: linear-gradient(90deg, #132e24da, #28493460);
}
.classic-hero-copy {
  position: relative;
  padding: 34rpx 28rpx;
  font-size: 26rpx;
}
.classic-hero-title {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 47rpx;
  line-height: 1.35;
  margin-bottom: 10rpx;
}
.classic-desk {
  padding: 28rpx;
  background: #fafbf4;
}
.classic-task-title {
  font-size: 38rpx;
  line-height: 1.36;
  font-weight: 650;
  margin: 17rpx 0 8rpx;
}
.classic-coverage {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  margin-top: 24rpx;
}
.classic-coverage > text:last-child {
  font-variant-numeric: tabular-nums;
  color: var(--blue);
  font-weight: 650;
}
.classic-attention { padding: 0 24rpx; }
.classic-list-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 90rpx;
  gap: 16rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--ink);
  font-size: 26rpx;
  border-radius: 0;
}
.classic-list-button::after { border: none; }
.classic-list-button + .classic-list-button { border-top: 1rpx solid var(--line); }
.classic-list-button > text:last-child { color: var(--blue); }
.classic-steps { margin-top: 18rpx; }
.classic-steps .flow-button { background: #fafbf4; }
