<view class="page theme-{{theme}}">
  <view class="title bm-enter stagger-1">数据导入与作业</view>
  <view class="work-task-meta bm-enter stagger-1" wx:if="{{task}}">
    <view class="card-headline" style="margin-top: 0;">{{task.name}} · {{task.currency}}</view>
    <view class="muted">{{task.start_date}} — {{task.end_date}}</view>
    <view class="work-status-strip">
      <view class="work-status-pill">
        <text class="muted">银行流水</text>
        <text class="work-status-num">{{task.summary.sides.BANK.valid || 0}} 行</text>
      </view>
      <view class="work-status-pill">
        <text class="muted">企业账簿</text>
        <text class="work-status-num">{{task.summary.sides.BOOK.valid || 0}} 行</text>
      </view>
      <view class="work-status-pill">
        <text class="muted">待核对预览</text>
        <text class="work-status-num">{{batches.length}} 批</text>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{progress}}" class="notice">{{progress}}</view>
  <bm-loading wx:if="{{!task && !error}}" theme="{{theme}}" text="正在读取导入与作业" />
  <view wx:if="{{task && !enabled}}" class="notice">当前部署未开启后台作业，请在电脑端继续导入。</view>

  <block wx:if="{{task && enabled}}">
    <view wx:if="{{!task.current_run}}" class="card bm-enter stagger-2">
      <view class="step-header">
        <text class="step-badge">步骤 1</text>
        <text class="heading">本地分块上传</text>
      </view>
      <view class="field-label">选择本次上传的数据来源</view>
      <view class="side-switch">
        <view
          class="side-option {{side === 0 ? 'active' : ''}}"
          data-side="0"
          bindtap="selectSide"
          aria-role="radio"
          aria-checked="{{side === 0}}"
        >
          <text class="side-option-title">银行流水</text>
          <text class="side-option-sub">银行对账单</text>
        </view>
        <view
          class="side-option {{side === 1 ? 'active' : ''}}"
          data-side="1"
          bindtap="selectSide"
          aria-role="radio"
          aria-checked="{{side === 1}}"
        >
          <text class="side-option-title">企业账簿</text>
          <text class="side-option-sub">企业日记账</text>
        </view>
      </view>
      <button class="secondary" disabled="{{busy}}" bindtap="chooseFile">{{file ? file.name : '从微信聊天 / 文件传输助手选择文件'}}</button>
      <view class="field">
        <text class="field-label">Excel 工作表</text>
        <input class="control" placeholder="默认首表" value="{{sheet}}" data-name="sheet" bindinput="setting" disabled="{{busy}}" />
      </view>
      <view class="field">
        <text class="field-label">表头行号</text>
        <input class="control" type="number" value="{{header}}" data-name="header" bindinput="setting" disabled="{{busy}}" />
      </view>
      <view class="muted">支持 CSV、Excel、文本 PDF（单文件上限 10 MB）。微信沙盒限制仅可从聊天记录选文件，建议先将对账单发到「文件传输助手」再选取；断线后重选同一文件可续传。</view>
      <button class="primary" disabled="{{!file || busy}}" bindtap="enqueueFile">上传{{sides[side]}}文件</button>
    </view>

    <view wx:if="{{batches.length}}" class="card bm-enter stagger-3">
      <view class="step-header">
        <text class="step-badge">步骤 2</text>
        <text class="heading">待核对预览</text>
      </view>
      <view class="muted" style="margin-bottom: 12rpx;">请依次点击下方文件，核对字段映射并点「提交后台校验并发布」；银行与账簿两侧均发布后将自动出现「运行后台匹配」按钮。</view>
      <button wx:for="{{batches}}" wx:key="id" class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="selectBatch">
        {{item.side === 'BANK' ? '银行流水' : '企业账簿'}} · {{item.filename}} · {{item.row_count}} 行 →
      </button>
    </view>

    <view wx:if="{{draft}}" class="card bm-enter stagger-3">
      <view class="step-header">
        <text class="step-badge">步骤 3</text>
        <text class="heading">映射与控制数核验</text>
      </view>
      <view class="muted" style="margin-bottom: 14rpx;">当前文件：{{draft.batch.filename}}</view>
      <button class="secondary" disabled="{{busy}}" bindtap="original">打开授权原件</button>

      <scroll-view scroll-x class="preview">
        <view wx:for="{{draft.rows}}" wx:key="row_no" class="preview-row">
          <text class="preview-idx">{{item.page ? '第 ' + item.page + ' 页 · ' : ''}}原行 {{item.row_no}}</text>
          <text class="cell" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key">{{cell.key}}　{{cell.value}}</text>
        </view>
      </scroll-view>

      <view wx:if="{{draft.visual}}" class="actions">
        <button wx:if="{{draft.extractionPage < 1}}" class="secondary" disabled="{{busy}}" data-step="1" bindtap="extraction">读取完整提取记录</button>
        <button wx:if="{{draft.extractionPage > 1}}" class="secondary" disabled="{{busy}}" data-step="-1" bindtap="extraction">上一批</button>
        <button wx:if="{{draft.hasNext}}" class="secondary" disabled="{{busy}}" data-step="1" bindtap="extraction">下一批</button>
      </view>

      <view class="sub-heading">字段与格式映射</view>
      <picker mode="selector" range="{{directionLabels}}" value="{{draft.direction + 1}}" data-name="direction" bindchange="edit" disabled="{{busy}}">
        <view class="control picker-control">
          <text>收支方向 · {{directionLabels[draft.direction + 1]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <picker mode="selector" range="{{formatLabels}}" value="{{draft.format + 1}}" data-name="format" bindchange="edit" disabled="{{busy}}">
        <view class="control picker-control">
          <text>日期格式 · {{formatLabels[draft.format + 1]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
      <picker wx:for="{{draft.fields}}" wx:key="id" mode="selector" range="{{draft.choices}}" value="{{item.index}}"
        data-name="field" data-index="{{index}}" bindchange="edit" disabled="{{busy}}">
        <view class="control picker-control">
          <text>{{item.title}} · {{draft.choices[item.index]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>

      <view wx:if="{{draft.document}}" class="verify-block">
        <view class="sub-heading">独立核验原件控制数</view>
        <view class="muted">从原件核对笔数、收支与余额。流水号逐行按原件抄录，空白号保留空行。</view>
        <view wx:for="{{draft.totals}}" wx:key="id" class="field">
          <text class="field-label">{{item.title}}</text>
          <input class="control" value="{{item.value}}" maxlength="{{item.id === 'note' ? 300 : 22}}" data-name="total" data-index="{{index}}" bindinput="edit" disabled="{{busy}}" />
        </view>
        <picker mode="selector" range="{{orders}}" value="{{draft.order}}" data-name="order" bindchange="edit" disabled="{{busy}}">
          <view class="control picker-control">
            <text>逐笔余额顺序 · {{orders[draft.order]}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>

        <block wx:if="{{draft.visual}}">
          <view class="row field">
            <text>原件确无流水号列</text>
            <switch data-name="noReference" checked="{{draft.noReference}}" bindchange="edit" disabled="{{busy}}" />
          </view>
          <view class="page-controls" wx:for="{{draft.pages}}" wx:for-item="sheetPage" wx:for-index="pageIndex" wx:key="number">
            <view class="sub-heading" style="margin-top: 8rpx;">原件第 {{sheetPage.number}} 页</view>
            <view wx:for="{{sheetPage.fields}}" wx:key="id" class="field">
              <text class="field-label">{{item.title}}</text>
              <textarea wx:if="{{item.id === 'references'}}" class="control" value="{{item.value}}" maxlength="-1"
                data-name="page" data-page="{{pageIndex}}" data-index="{{index}}" bindinput="edit" disabled="{{busy || draft.noReference}}" />
              <input wx:else class="control" value="{{item.value}}" maxlength="22"
                data-name="page" data-page="{{pageIndex}}" data-index="{{index}}" bindinput="edit" disabled="{{busy}}" />
            </view>
          </view>
        </block>

        <view class="row field">
          <text>已核对原件与控制数</text>
          <switch data-name="sourceVerified" checked="{{draft.sourceVerified}}" bindchange="edit" disabled="{{busy}}" />
        </view>
      </view>

      <view class="row field">
        <text>已确认列、日期和收支方向</text>
        <switch data-name="confirmed" checked="{{draft.confirmed}}" bindchange="edit" disabled="{{busy}}" />
      </view>
      <button class="primary" disabled="{{busy || !draft.confirmed || (draft.document && !draft.sourceVerified)}}" bindtap="publish">提交后台校验并发布</button>
    </view>

    <button wx:if="{{canMatch}}" class="primary bm-enter stagger-4" disabled="{{busy}}" bindtap="match">运行后台匹配</button>

    <view class="card bm-enter stagger-4">
      <view class="heading" style="margin-bottom: 12rpx;">后台作业记录</view>
      <view wx:if="{{!jobs.length}}" class="muted">暂无作业记录</view>
      <view wx:for="{{jobs}}" wx:key="id" class="job">
        <view class="row">
          <text class="job-title">{{item.title}}</text>
          <text class="pill {{item.status === 'SUCCEEDED' ? 'success' : item.status === 'FAILED' ? 'error' : 'amber'}}">{{item.displayStatus}}</text>
        </view>
        <view wx:if="{{item.progressText}}" class="muted" style="margin-top: 8rpx;">上传进度：{{item.progressText}}</view>
        <view wx:if="{{item.errorText}}" class="notice error">{{item.errorText}}</view>
        <view class="actions" wx:if="{{(item.error && item.error.retryable) || item.canCancel}}">
          <button wx:if="{{item.error && item.error.retryable}}" class="secondary" disabled="{{busy}}" data-id="{{item.id}}" data-action="retry" bindtap="jobAction">重试</button>
          <button wx:if="{{item.canCancel}}" class="secondary" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="jobAction">取消</button>
        </view>
      </view>
    </view>
  </block>
</view>
