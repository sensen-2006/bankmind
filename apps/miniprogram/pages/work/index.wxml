<view class="page theme-{{theme}}">
  <view class="work-task-banner" wx:if="{{task}}">
    <view class="row">
      <text class="task-name">{{task.name}}</text>
      <text class="pill">{{task.currency}}</text>
    </view>
    <view class="muted" style="margin-top:6rpx">{{task.start_date}} — {{task.end_date}}</view>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{progress}}" class="notice">{{progress}}</view>
  <bm-loading wx:if="{{!task && !error}}" text="正在读取导入与作业"/>
  <view wx:if="{{task && !enabled}}" class="notice">当前环境未开启移动端后台作业，请前往电脑端继续导入。</view>

  <block wx:if="{{task && enabled}}">
    <view wx:if="{{!task.current_run}}" class="card">
      <view class="step-heading"><text class="step-badge">1</text><text>上传对账文件</text></view>
      <view class="form-label" style="margin-top:14rpx">数据来源</view>
      <picker mode="selector" range="{{sides}}" value="{{side}}" data-name="side" bindchange="setting">
        <view class="picker-box">
          <text class="picker-label">来源侧别</text>
          <text class="picker-value">{{sides[side]}} ▾</text>
        </view>
      </picker>

      <button class="secondary" disabled="{{busy}}" bindtap="chooseFile">{{file ? file.name : '从聊天记录选择文件'}}</button>

      <view class="work-inline-fields">
        <view class="field">
          <view class="form-label">Excel 工作表</view>
          <input placeholder="默认首表" placeholder-class="input-placeholder" value="{{sheet}}" data-name="sheet" bindinput="setting" disabled="{{busy}}"/>
        </view>
        <view class="field">
          <view class="form-label">表头行号</view>
          <input type="number" value="{{header}}" data-name="header" bindinput="setting" disabled="{{busy}}"/>
        </view>
      </view>

      <view class="muted" style="margin-top:12rpx">支持 CSV、Excel、文本 PDF。如遇断线，重新选择同一文件即可断点续传。</view>
      <button class="primary" disabled="{{!file || busy}}" bindtap="enqueueFile">上传对账文件</button>
    </view>

    <view wx:if="{{batches.length}}" class="card">
      <view class="step-heading"><text class="step-badge">2</text><text>待核对预览</text></view>
      <button
        wx:for="{{batches}}"
        wx:key="id"
        class="secondary"
        disabled="{{busy}}"
        data-id="{{item.id}}"
        bindtap="selectBatch"
      >
        {{item.side === 'BANK' ? '银行流水' : '企业账簿'}} · {{item.filename}} · {{item.row_count}} 行
      </button>
    </view>

    <view wx:if="{{draft}}" class="card">
      <view class="step-heading"><text class="step-badge">3</text><text>核对映射 · {{draft.batch.filename}}</text></view>
      <button class="secondary" disabled="{{busy}}" bindtap="original">查看授权原件</button>

      <scroll-view scroll-x class="preview">
        <view wx:for="{{draft.rows}}" wx:key="row_no" class="preview-row">
          <text class="preview-rowno">{{item.page ? 'P' + item.page + ' · ' : ''}}行 {{item.row_no}}</text>
          <view class="cell" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key">
            <text class="cell-key">{{cell.key}}</text>
            <text class="cell-val">{{cell.value}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{draft.visual}}" class="actions">
        <button wx:if="{{draft.extractionPage < 1}}" class="secondary" disabled="{{busy}}" data-step="1" bindtap="extraction">读取完整提取记录</button>
        <button wx:if="{{draft.extractionPage > 1}}" class="secondary" disabled="{{busy}}" data-step="-1" bindtap="extraction">上一批</button>
        <button wx:if="{{draft.hasNext}}" class="secondary" disabled="{{busy}}" data-step="1" bindtap="extraction">下一批</button>
      </view>

      <view class="form-label">收支方向与日期格式</view>
      <view class="picker-stack">
        <picker mode="selector" range="{{directionLabels}}" value="{{draft.direction + 1}}" data-name="direction" bindchange="edit" disabled="{{busy}}">
          <view class="picker-box">
            <text class="picker-label">收支方向</text>
            <text class="picker-value">{{directionLabels[draft.direction + 1]}} ▾</text>
          </view>
        </picker>
        <picker mode="selector" range="{{formatLabels}}" value="{{draft.format + 1}}" data-name="format" bindchange="edit" disabled="{{busy}}">
          <view class="picker-box">
            <text class="picker-label">日期格式</text>
            <text class="picker-value">{{formatLabels[draft.format + 1]}} ▾</text>
          </view>
        </picker>
      </view>

      <view class="form-label">字段映射</view>
      <view class="picker-stack">
        <picker
          wx:for="{{draft.fields}}"
          wx:key="id"
          mode="selector"
          range="{{draft.choices}}"
          value="{{item.index}}"
          data-name="field"
          data-index="{{index}}"
          bindchange="edit"
          disabled="{{busy}}"
        >
          <view class="picker-box">
            <text class="picker-label">{{item.title}}</text>
            <text class="picker-value">{{draft.choices[item.index]}} ▾</text>
          </view>
        </picker>
      </view>

      <view wx:if="{{draft.document}}" class="work-subblock">
        <view class="card-title" style="margin-bottom:8rpx">原件控制数核验</view>
        <view class="muted">请对照原件录入笔数、收支合计与期初期末余额。</view>
        <view wx:for="{{draft.totals}}" wx:key="id" class="field">
          <view class="form-label">{{item.title}}</view>
          <input value="{{item.value}}" maxlength="{{item.id === 'note' ? 300 : 22}}" data-name="total" data-index="{{index}}" bindinput="edit" disabled="{{busy}}"/>
        </view>
        <view class="form-label">逐笔余额顺序</view>
        <picker mode="selector" range="{{orders}}" value="{{draft.order}}" data-name="order" bindchange="edit" disabled="{{busy}}">
          <view class="picker-box">
            <text class="picker-label">余额顺序</text>
            <text class="picker-value">{{orders[draft.order]}} ▾</text>
          </view>
        </picker>
        <block wx:if="{{draft.visual}}">
          <view class="row switch-row">
            <text>原件确无流水号列</text>
            <switch color="#0D9488" data-name="noReference" checked="{{draft.noReference}}" bindchange="edit" disabled="{{busy}}"/>
          </view>
          <view class="page-controls" wx:for="{{draft.pages}}" wx:for-item="sheetPage" wx:for-index="pageIndex" wx:key="number">
            <view class="card-title" style="margin-bottom:8rpx">原件第 {{sheetPage.number}} 页</view>
            <view wx:for="{{sheetPage.fields}}" wx:key="id" class="field">
              <view class="form-label">{{item.title}}</view>
              <textarea
                wx:if="{{item.id === 'references'}}"
                value="{{item.value}}"
                maxlength="-1"
                data-name="page"
                data-page="{{pageIndex}}"
                data-index="{{index}}"
                bindinput="edit"
                disabled="{{busy || draft.noReference}}"
              />
              <input
                wx:else
                value="{{item.value}}"
                maxlength="22"
                data-name="page"
                data-page="{{pageIndex}}"
                data-index="{{index}}"
                bindinput="edit"
                disabled="{{busy}}"
              />
            </view>
          </view>
        </block>
        <view class="row switch-row">
          <text>已核对原件与控制数</text>
          <switch color="#0D9488" data-name="sourceVerified" checked="{{draft.sourceVerified}}" bindchange="edit" disabled="{{busy}}"/>
        </view>
      </view>

      <view class="row switch-row">
        <text>已确认列映射、日期与收支方向</text>
        <switch color="#0D9488" data-name="confirmed" checked="{{draft.confirmed}}" bindchange="edit" disabled="{{busy}}"/>
      </view>

      <button class="primary" disabled="{{busy || !draft.confirmed || (draft.document && !draft.sourceVerified)}}" bindtap="publish">提交校验并发布</button>
    </view>

    <button wx:if="{{canMatch}}" class="primary" disabled="{{busy}}" bindtap="match">运行智能匹配</button>

    <view class="card">
      <view class="card-title">后台作业记录</view>
      <view wx:if="{{!jobs.length}}" class="muted">暂无作业记录</view>
      <view wx:for="{{jobs}}" wx:key="id" class="job">
        <view class="row">
          <text class="note-title">{{item.title}}</text>
          <text class="pill {{item.status === 'SUCCEEDED' ? 'success' : (item.status === 'FAILED' ? 'error' : 'amber')}}">{{item.displayStatus}}</text>
        </view>
        <view wx:if="{{item.progressText}}" class="muted" style="margin-top:8rpx">已传输 {{item.progressText}}</view>
        <view wx:if="{{item.errorText}}" class="notice error">{{item.errorText}}</view>
        <view class="actions" wx:if="{{(item.error && item.error.retryable) || item.canCancel}}">
          <button wx:if="{{item.error && item.error.retryable}}" class="secondary" disabled="{{busy}}" data-id="{{item.id}}" data-action="retry" bindtap="jobAction">重试</button>
          <button wx:if="{{item.canCancel}}" class="secondary danger" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="jobAction">取消</button>
        </view>
      </view>
    </view>
  </block>
</view>
