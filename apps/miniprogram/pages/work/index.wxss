.work-task-meta {
  margin-bottom: 12rpx;
}

.work-status-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.work-status-pill {
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.theme-dark .work-status-pill {
  background: rgba(16, 33, 42, 0.74);
  border-color: rgba(255, 255, 255, 0.1);
}

.work-status-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #13201d);
  font-variant-numeric: tabular-nums;
}

.theme-dark .work-status-num {
  color: #5fd3a6;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.step-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(38, 184, 136, 0.14);
  color: #116f51;
}

.theme-dark .step-badge {
  background: rgba(95, 211, 166, 0.16);
  color: #7ee0b8;
}

.heading {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--ink, #13201d);
}

.sub-heading {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink, #13201d);
  margin: 26rpx 0 12rpx;
}

.field {
  margin: 18rpx 0;
  font-size: 25rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted, #5b726a);
  font-size: 24rpx;
}

/* Completely eliminate double-border box-inside-box on pickers */
picker {
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  min-height: 0 !important;
  box-shadow: none !important;
}

.control {
  box-sizing: border-box;
  width: 100%;
  margin: 10rpx 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line, rgba(19, 32, 29, 0.1));
  border-radius: 22rpx;
  min-height: 84rpx;
  background: rgba(255, 255, 255, 0.84);
  color: var(--ink, #13201d);
  display: flex;
  align-items: center;
}

.picker-control {
  justify-content: space-between;
  gap: 12rpx;
}

.picker-arrow {
  color: var(--muted, #5b726a);
  font-size: 24rpx;
  flex-shrink: 0;
}

.preview {
  width: 100%;
  margin: 18rpx 0;
  border-radius: 20rpx;
}

.preview-row {
  display: flex;
  gap: 22rpx;
  white-space: nowrap;
  min-width: max-content;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid var(--line, rgba(19, 32, 29, 0.08));
  font-size: 24rpx;
}

.preview-idx {
  font-weight: 600;
  color: var(--blue, #26b888);
}

.cell {
  display: inline-block;
}

.verify-block {
  margin-top: 18rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--line, rgba(19, 32, 29, 0.08));
}

.page-controls,
.job {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line, rgba(19, 32, 29, 0.08));
}

.job-title {
  font-weight: 600;
  font-size: 27rpx;
  color: var(--ink, #13201d);
}

.card button {
  margin-top: 16rpx;
}
