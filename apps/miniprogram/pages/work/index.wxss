.heading{font-weight:650;font-size:32rpx;margin-bottom:12rpx}
.field{margin:14rpx 0}
.control{box-sizing:border-box;width:100%;margin:8rpx 0;padding:14rpx;border:1px solid var(--bm-line,#d6dfd6);border-radius:14rpx;min-height:72rpx;background:#fafbf5}
.preview{width:100%;margin:12rpx 0}
.preview-row{display:flex;gap:18rpx;white-space:nowrap;min-width:max-content;padding:10rpx 0;border-bottom:1px solid #d6dfd6}
.cell{display:inline-block}
.page-controls,.job{margin-top:14rpx;padding-top:12rpx;border-top:1px solid #d6dfd6}
.card button{margin-top:10rpx}
