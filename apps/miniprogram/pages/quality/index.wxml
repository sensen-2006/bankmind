<view class="workspace-mode workspace-mode-{{workspaceMode}}">
<view class="page">
  <view class="page-title-row"><view class="title">质量检查</view><text class="page-count" wx:if="{{!loading}}">{{total}} 行</text></view>
  <view class="chip-list">
    <button wx:for="{{filters}}" wx:key="id" class="chip {{quality === item.id ? 'active' : ''}}" data-quality="{{item.id}}" bindtap="filter">{{item.label}}</button>
  </view>
  <view class="notice error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view>
  <bm-loading wx:if="{{loading}}" text="正在读取记录"/>
  <view class="empty" wx:if="{{!loading && !error && !items.length}}">当前分类没有记录。</view>
  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="row"><text class="pill">{{item.qualityLabel}}</text><text class="money">{{item.displayAmount}}</text></view>
    <view class="card-title">{{item.counterparty || '未提供对方名称'}}</view>
    <view class="muted">{{item.side === 'BANK' ? '银行流水' : '企业账簿'}} · 第 {{item.row_no}} 行</view>
    <view class="muted">{{item.date}} · {{item.reference || '无参考号'}}</view>
    <view wx:for="{{item.issues}}" wx:for-item="issue" wx:key="code" class="notice">{{issue.message}}</view>
    <button class="secondary" data-id="{{item.id}}" bindtap="open">原行证据 →</button>
  </view>
  <view class="actions" wx:if="{{page > 1 || more}}">
    <button class="secondary" data-step="-1" disabled="{{page <= 1 || loading}}" bindtap="changePage">上一页</button>
    <button class="secondary" data-step="1" disabled="{{!more || loading}}" bindtap="changePage">下一页</button>
  </view>
</view>
</view>
