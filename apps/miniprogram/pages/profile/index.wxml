<view class="page theme-{{theme}}">
  <view class="title bm-enter stagger-1">我的</view>
  <view class="notice error" wx:if="{{error}}">{{error}}</view>

  <view class="profile-identity bm-enter stagger-1" wx:if="{{user}}">
    <view class="profile-avatar">{{user.initial}}</view>
    <view class="card-headline" style="margin-top: 0; font-size: 36rpx;">{{user.name}}</view>
    <view class="muted" style="margin-top: 6rpx;">{{user.tenant_name}}</view>
    <text class="pill" style="margin-top: 16rpx;">{{user.roleLabel}}</text>
  </view>

  <view class="card bm-enter stagger-2">
    <view class="theme-setting-row">
      <view class="theme-setting-meta">
        <text class="theme-setting-title">外观模式</text>
        <text class="muted">在明亮与深色之间切换</text>
      </view>
      <bm-daylight-toggle theme="{{theme}}" bindchange="onThemeChange" />
    </view>
    <view class="divider" />
    <view class="theme-setting-row">
      <view class="theme-setting-meta">
        <text class="theme-setting-title">交互音效</text>
        <text class="muted">按钮轻触、切换主题与审批提示音</text>
      </view>
      <view style="display: flex; align-items: center; gap: 12rpx;">
        <button class="inline-action" style="font-size: 24rpx;" bindtap="previewSound">试听</button>
        <switch checked="{{soundEnabled}}" color="#26b888" bindchange="toggleSound" />
      </view>
    </view>
  </view>

  <view class="section bm-enter stagger-3">授权账户</view>
  <view class="card bank-account bm-enter stagger-3" wx:for="{{accounts}}" wx:key="id">
    <view class="row">
      <text style="font-weight: 600;">{{item.bank}}</text>
      <text class="pill">{{item.currency}}</text>
    </view>
    <view class="account-number">{{item.number_masked}}</view>
    <view class="muted">{{item.name}}</view>
  </view>

  <view class="card bm-enter stagger-4">
    <view class="row">
      <view class="card-title">企业身份</view>
      <bm-help label="身份绑定" text="需由企业管理员开通微信登录，并先绑定当前企业账号。账号权限由服务器校验。" />
    </view>
    <view class="kv"><text>用户名</text><text>{{user.username}}</text></view>
    <view class="kv"><text>登录模式</text><text>{{mode === 'wechat' ? '微信身份' : '企业账号'}}</text></view>
    <button class="secondary" bindtap="bindWechat">绑定当前微信</button>
    <view class="connection-row">
      <text>服务连接</text>
      <bm-help label="当前服务地址" text="{{apiBase}}" />
    </view>
  </view>

  <button class="secondary danger logout-button bm-enter stagger-4" bindtap="logout">退出登录</button>
</view>
