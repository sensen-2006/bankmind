<view class="page approvals-page theme-{{theme}}">
  <view class="page-title-row bm-enter stagger-1">
    <view class="title">待复核</view>
    <bm-help label="独立复核" text="本人提交的事项须由另一位授权人员复核。处理前请核对交易、匹配依据和材料。" />
  </view>

  <view class="approval-summary bm-enter stagger-2" wx:if="{{!loading}}">
    <view>
      <view class="value">{{matchTotal}}</view>
      <view class="muted">匹配确认</view>
    </view>
    <view>
      <view class="value">{{cases.length}}</view>
      <view class="muted">异常审批</view>
    </view>
  </view>

  <view class="search-box bm-enter stagger-2" wx:if="{{!loading && (matches.length || cases.length || query)}}">
    <view class="search-symbol" />
    <input placeholder="搜索本页对方名称、金额、日期或方式" value="{{query}}" bindinput="onSearch" aria-label="搜索待复核事项" />
  </view>

  <view class="notice error" wx:if="{{error}}" bindtap="retry">{{error}} · 轻触重试</view>
  <bm-loading wx:if="{{loading}}" theme="{{theme}}" text="正在同步待办" />

  <view class="empty" wx:if="{{!loading && !filteredMatches.length && !filteredCases.length}}">
    <view class="empty-check">✓</view>
    <view>{{query ? '没有符合搜索条件的待办' : '暂时没有待办'}}</view>
  </view>

  <view class="row section-heading bm-enter stagger-3" wx:if="{{filteredMatches.length}}">
    <view class="section">匹配确认</view>
    <text class="muted" wx:if="{{totalPages > 1}}">第 {{page}} / {{totalPages}} 页</text>
  </view>

  <view
    class="card review-card tappable bm-enter stagger-3"
    wx:for="{{filteredMatches}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="match"
    aria-role="button"
  >
    <view class="row">
      <view class="card-title">{{item.bankFirst.counterparty || '未提供对方'}}</view>
      <view class="bento-arrow-pill">↗</view>
    </view>
    <view class="row" style="margin-top: 10rpx;">
      <text class="pill amber">{{item.statusLabel}}</text>
      <text class="muted">{{item.methodLabel}}</text>
    </view>
    <view class="review-amount">{{item.displayAmount}}<text>{{item.bankFirst.currency}}</text></view>
    <view class="muted">{{item.bankFirst.date}}</view>
    <view class="task-bottom">
      <text>{{item.bank.length}} 银行流水 ↔ {{item.book.length}} 企业账簿</text>
      <text>核对证据 →</text>
    </view>
  </view>

  <view class="pagination-wrap" wx:if="{{!loading && totalPages > 1}}">
    <view class="pagination-bar">
      <button class="secondary page-btn" disabled="{{page <= 1}}" bindtap="prevPage">上一页</button>
      <view class="pagination-info">{{page}} / {{totalPages}} 页 · 共 {{matchTotal}} 条</view>
      <button class="secondary page-btn" disabled="{{page >= totalPages}}" bindtap="nextPage">下一页</button>
    </view>
    <view class="pagination-jump">
      <text class="muted">跳至第</text>
      <input
        class="jump-input"
        type="number"
        value="{{jumpInput}}"
        placeholder="{{page}}"
        bindinput="onJumpInput"
        bindconfirm="jumpToPage"
      />
      <text class="muted">页</text>
      <button class="secondary jump-btn" bindtap="jumpToPage">跳转</button>
    </view>
  </view>

  <view class="section bm-enter stagger-4" wx:if="{{filteredCases.length}}">异常审批</view>
  <view
    class="card exception-card tappable bm-enter stagger-4"
    wx:for="{{filteredCases}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="detail"
    aria-role="button"
  >
    <view class="row">
      <view class="card-title">{{item.title}}</view>
      <view class="bento-arrow-pill">↗</view>
    </view>
    <view class="task-bottom">
      <text>待主管复核</text>
      <text>查看依据 →</text>
    </view>
  </view>
</view>
