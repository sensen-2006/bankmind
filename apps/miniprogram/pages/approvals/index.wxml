<view class="workspace-mode workspace-mode-{{workspaceMode}}">
<view class="page approvals-page">
  <view class="page-title-row"><view class="title">待复核</view><bm-help label="独立复核" text="本人提交的事项须由另一位授权人员复核。处理前请核对交易、匹配依据和材料。"/></view>
  <view class="approval-summary" wx:if="{{!loading}}"><view><view class="value">{{matchTotal}}</view><view class="muted">匹配确认</view></view><view><view class="value">{{cases.length}}</view><view class="muted">异常审批</view></view></view>
  <view class="card row" wx:if="{{scope}}"><text>{{scope.name}}</text><button class="inline-action" bindtap="allTasks">查看全部任务</button></view>
  <view class="notice error" wx:if="{{error}}">{{error}}</view><bm-loading wx:if="{{loading}}" text="正在同步待办"/>
  <view class="empty" wx:if="{{!loading && !matches.length && !cases.length}}"><view class="empty-check">✓</view><view>暂时没有待办</view></view>
  <view class="section" wx:if="{{matches.length}}">匹配确认</view>
  <view class="card review-card" wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" bindtap="match" aria-role="button"><view class="row"><view class="card-title">{{item.bankFirst.counterparty || '未提供对方'}}</view><text class="pill amber">{{item.statusLabel}}</text></view><view class="review-amount">{{item.bankFirst.amount}}<text>{{item.bankFirst.currency}}</text></view><view class="muted">{{item.bankFirst.date}} · {{item.methodLabel}}</view><view class="task-bottom"><text>{{item.bank.length}} 银行 ↔ {{item.book.length}} 账面</text><text>核对证据 →</text></view></view>
  <view class="actions" wx:if="{{page > 1 || hasNext}}">
    <button class="secondary" data-change="-1" disabled="{{page <= 1 || loading}}" bindtap="pageStep">上一页</button>
    <button class="secondary" data-change="1" disabled="{{!hasNext || loading}}" bindtap="pageStep">下一页</button>
  </view>
  <view class="section" wx:if="{{cases.length}}">异常审批</view>
  <view class="card exception-card" wx:for="{{cases}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" aria-role="button"><view class="card-title">{{item.title}}</view><view class="task-bottom"><text>待审批</text><text>查看依据 →</text></view></view>
</view>
</view>
