<view class="workspace-mode workspace-mode-{{workspaceMode}}">
<view class="page">
  <view class="title">对账报告</view>
  <view class="muted" wx:if="{{task}}">{{task.name}} · {{task.currency}}</view>
  <view class="notice error" wx:if="{{error}}">{{error}}</view>
  <bm-loading wx:if="{{loading}}" text="正在读取报告"/>
  <view class="card" wx:if="{{task}}">
    <view class="card-title">余额完整性</view>
    <view class="kv" wx:for="{{controls}}" wx:key="id"><text>{{item.label}}</text><text>{{item.status}}</text></view>
    <view class="kv" wx:if="{{adjustment.status === 'CALCULATED'}}"><text>调节后差额</text><text>{{adjustment.gap}} {{task.currency}}</text></view>
    <button class="secondary" wx:if="{{canBalance && !editing}}" bindtap="editBalances">录入两侧期初和期末余额</button>
    <block wx:if="{{editing}}">
      <view class="note" wx:for="{{balance}}" wx:key="id">
        <view class="card-title">{{item.label}}</view>
        <view class="form-label">期初余额</view><input value="{{item.opening}}" data-index="{{index}}" data-field="opening" bindinput="balanceInput"/>
        <view class="form-label">期末余额</view><input value="{{item.closing}}" data-index="{{index}}" data-field="closing" bindinput="balanceInput"/>
      </view>
      <view class="form-label">余额核对依据</view><textarea value="{{reason}}" bindinput="reasonInput"/>
      <view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="cancelBalance">取消</button><button class="primary" disabled="{{busy}}" bindtap="saveBalance">保存余额</button></view>
    </block>
  </view>
  <view class="card" wx:if="{{task && !editing}}">
    <view class="card-title">来源控制声明</view>
    <view class="note" wx:if="{{!sources.length}}">尚未提交两侧来源控制数。</view>
    <view class="note" wx:for="{{sources}}" wx:key="id">
      <view class="row"><text>{{item.declaration.source_reference}}</text><text class="pill">{{item.statusLabel}}</text></view>
      <view class="muted">银行 {{item.result.BANK.declared_rows}} / {{item.result.BANK.actual_rows}} 行 · 账簿 {{item.result.BOOK.declared_rows}} / {{item.result.BOOK.actual_rows}} 行</view>
      <view class="muted">银行净额 {{item.result.BANK.declared_net}} / {{item.result.BANK.actual_net}}</view>
      <view class="muted">账簿净额 {{item.result.BOOK.declared_net}} / {{item.result.BOOK.actual_net}}</view>
      <button class="secondary" wx:if="{{item.canReview && !sourceSelection}}" data-id="{{item.id}}" bindtap="selectSource">独立核验</button>
    </view>
    <button class="secondary" wx:if="{{canBalance && task.current_run && !sourceForm}}" bindtap="editSource">提交来源声明</button>
    <block wx:if="{{sourceForm}}">
      <view class="muted">按独立的银行或账务系统原件填写两侧控制数。</view>
      <view class="note" wx:for="{{sourceForm.rows}}" wx:key="id">
        <text>{{item.label}}</text><view class="form-label">原始笔数</view>
        <input type="number" value="{{item.count}}" data-index="{{index}}" data-field="count" bindinput="editSourceValue"/>
        <view class="form-label">收支净额</view><input value="{{item.net}}" data-index="{{index}}" data-field="net" bindinput="editSourceValue"/>
      </view>
      <view class="form-label">来源编号</view><input value="{{sourceForm.reference}}" data-field="reference" bindinput="editSourceValue"/>
      <view class="form-label">账户和期间核验说明</view><textarea value="{{sourceForm.statement}}" data-field="statement" bindinput="editSourceValue"/>
      <view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="cancelSource">取消</button><button class="primary" disabled="{{busy}}" bindtap="submitSource">提交核验</button></view>
    </block>
    <block wx:if="{{sourceSelection}}">
      <view class="form-label">独立核验意见 · {{sourceSelection.declaration.source_reference}}</view>
      <textarea value="{{sourceReason}}" bindinput="sourceReason"/>
      <view class="actions">
        <button class="secondary" disabled="{{busy}}" bindtap="cancelSource">取消</button>
        <button class="secondary danger" disabled="{{busy}}" data-action="REJECT" bindtap="decideSource">退回</button>
        <button class="primary" disabled="{{busy}}" data-action="APPROVE" bindtap="decideSource">核验通过</button>
      </view>
    </block>
  </view>
  <block wx:if="{{task && !editing}}">
    <view class="row section-heading">
      <view class="section">报告版本</view>
      <button wx:if="{{canDraft}}" class="inline-action" disabled="{{busy}}" bindtap="draft">生成草稿 ＋</button>
    </view>
    <view class="empty" wx:if="{{!loading && !reports.length}}">暂无报告。完成匹配后可以生成草稿。</view>
    <view class="card row" wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="view" aria-role="button">
      <view><view>{{item.dateLabel}}</view><view class="muted">版本 {{item.version}}</view></view>
      <text class="pill {{item.status === 'SIGNED' ? 'success' : 'amber'}}">{{item.statusLabel}} →</text>
    </view>
  </block>
  <view id="report-detail" class="card" wx:if="{{detail && !editing}}">
    <view class="row"><view class="card-title">报告快照 · {{detail.statusLabel}}</view><button class="inline-action" bindtap="close">收起</button></view>
    <view class="note">{{detail.disclaimer}}</view>
    <view class="kv"><text>银行已确认</text><text>{{detail.counts.BANK.matched}} / {{detail.counts.BANK.valid}}</text></view>
    <view class="kv"><text>账簿已确认</text><text>{{detail.counts.BOOK.matched}} / {{detail.counts.BOOK.valid}}</text></view>
    <view class="muted">报告 SHA-256</view><view class="mono">{{detail.sha256}}</view>
    <view class="actions" wx:if="{{canDownload || ownDraft}}">
      <button class="secondary" data-format="xlsx" disabled="{{busy}}" bindtap="download">查看 Excel</button>
      <button class="secondary" wx:if="{{canDownload && shareAvailable}}" data-format="csv" disabled="{{busy}}" bindtap="download">导出 CSV</button>
    </view>
    <button wx:if="{{canSign && !signing}}" class="primary" disabled="{{busy}}" bindtap="startSign">独立签署</button>
    <block wx:if="{{signing}}">
      <view class="form-label">签署依据</view><textarea value="{{reason}}" bindinput="reasonInput" placeholder="核对来源、余额和异常处理后填写依据"/>
      <view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="cancelSign">返回核对</button><button class="primary" disabled="{{busy}}" bindtap="sign">确认签署</button></view>
    </block>
  </view>
</view>
</view>
