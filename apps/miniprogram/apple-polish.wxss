/* 8. Staggered Entrance Micro-Animations (Pure WXSS 60fps) */
@keyframes bm-fade-up {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bm-enter {
  animation: bm-fade-up 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.stagger-1 {
  animation-delay: 0ms;
}
.stagger-2 {
  animation-delay: 60ms;
}
.stagger-3 {
  animation-delay: 120ms;
}
.stagger-4 {
  animation-delay: 180ms;
}

@media (prefers-reduced-motion: reduce) {
  .bm-enter {
    animation: none !important;
  }
  .bento-striped-bar .liquid-bar::after {
    animation: none !important;
  }
  .primary:active,
  .secondary:active,
  .tappable:active {
    transform: none !important;
  }
}

