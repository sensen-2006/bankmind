page{background:#f6fbf7;color:#315343;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:26rpx}view,text,button,input,textarea{box-sizing:border-box}.page{padding:36rpx 30rpx 55rpx}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#99bca3}.title{font-size:43rpx;font-weight:650;line-height:1.5;margin:14rpx 0}.sub{color:#9ebaa6;font-size:23rpx;line-height:1.8}.card{background:white;border:1rpx solid #e9f5ec;border-radius:18rpx;padding:30rpx;margin-top:24rpx;box-shadow:0 6rpx 18rpx #2c564204}.card-title{font-size:28rpx;font-weight:600;margin-bottom:18rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.muted{color:#9fbda7;font-size:22rpx}.pill{font-size:20rpx;color:#7dc6a3;background:#f4fbf6;border:1rpx solid #e6f5ea;border-radius:6rpx;padding:7rpx 11rpx;white-space:nowrap}.pill.amber{background:#fff7e9;color:#bd985b;border-color:#f9e9ce}.primary{background:#55ba8a;color:white;border-radius:10rpx;font-size:25rpx;padding:22rpx;line-height:1.4;border:0;margin-top:24rpx}.primary::after,.secondary::after{border:0}.secondary{background:white;color:#8ab5a0;border:1rpx solid #e2f2e7;border-radius:10rpx;font-size:23rpx;padding:18rpx;line-height:1.4;margin-top:20rpx}.danger{color:#cf7f8d}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.stat{background:#fff;border:1rpx solid #e8f5ec;border-radius:15rpx;padding:26rpx;margin-top:24rpx}.stat .value{font-size:49rpx;font-weight:650;color:#5baf87;margin:15rpx 0 7rpx}.notice{background:#f4faf6;border:1rpx solid #e7f5eb;border-radius:12rpx;padding:23rpx;color:#90c09e;font-size:22rpx;line-height:1.9;margin-top:24rpx}.notice.error{background:#fff2f3;color:#c88390;border-color:#f4dce1}.loading,.empty{text-align:center;color:#a9c6b1;font-size:25rpx;padding:70rpx 25rpx;line-height:1.9}.link{color:#75c49e;font-size:23rpx;padding:10rpx 0}.form-label{font-size:23rpx;color:#92b8a6;margin:25rpx 0 14rpx}input,textarea,picker{background:white;border:1rpx solid #e4f3e8;border-radius:10rpx;padding:22rpx;font-size:26rpx;color:#73a48c;width:100%;height:auto}textarea{min-height:160rpx;line-height:1.8}.divider{height:1rpx;background:#eff6f1;margin:25rpx 0}.mono{font-family:monospace;font-size:22rpx;word-break:break-all;color:#9ac0a4}.money{font-size:33rpx;font-weight:600;color:#4c9c85}.progress{height:9rpx;background:#edf7f0;border-radius:6rpx;overflow:hidden;margin:20rpx 0}.progress view{height:100%;background:#92d2a4}.kv{display:flex;justify-content:space-between;gap:20rpx;font-size:23rpx;margin:17rpx 0;line-height:1.8}.kv>text:first-child{color:#a6c0ad;min-width:120rpx}.kv>text:last-child{color:#8ab6a1;text-align:right;word-break:break-all}.actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.section{font-size:29rpx;font-weight:600;margin-top:36rpx}.chip-list{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:20rpx}.chip{padding:13rpx 19rpx;border-radius:8rpx;background:#fff;border:1rpx solid #e6f4ea;color:#9cc1a6;font-size:22rpx}.chip.active{background:#f2faf4;border-color:#d7efde;color:#7ac09e}.evidence-id{padding:10rpx 0;color:#84c4a5;font-family:monospace;font-size:21rpx}.ai{background:linear-gradient(135deg,#f5fbf7,#fff);border-color:#e6f5ea}.history-item{border-left:3rpx solid #e3f4e8;padding:0 0 24rpx 22rpx;margin-top:20rpx;color:#95bca0;font-size:23rpx;line-height:1.9}.bottom-space{height:30rpx}.note{font-size:23rpx;color:#9abfa4;line-height:1.9;white-space:pre-wrap;margin-top:18rpx}
