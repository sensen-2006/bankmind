.workspace-mode { min-height: 100vh; }
.workspace-mode-classic { background: var(--bg, #eeefe8); }

.workspace-mode-game {
  --bg: #101c22;
  --surface: #192930;
  --surface-secondary: #22343b;
  --ink: #f0eee4;
  --muted: #afbeb6;
  --blue: #d8c392;
  --blue-dark: #f0ddb0;
  --line: #3a4a4d;
  --dark-input: #11262e;
  --status-ok: #a9d4bd;
  --status-error: #ffbcc4;
  background: var(--bg);
  color: var(--ink);
}

.workspace-mode-game .card,
.workspace-mode-game .stat,
.workspace-mode-game .ai,
.workspace-mode-game .task-card,
.workspace-mode-game .profile-identity,
.workspace-mode-game .approval-summary,
.workspace-mode-game .search-box,
.workspace-mode-game .material-block,
.workspace-mode-game .collapse-toggle,
.workspace-mode-game .card.review-card {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--line);
  border-radius: 12rpx;
  box-shadow: none;
}

.workspace-mode-game .title,
.workspace-mode-game .card-title,
.workspace-mode-game .section,
.workspace-mode-game .money,
.workspace-mode-game .account-number,
.workspace-mode-game .task-name,
.workspace-mode-game .review-amount,
.workspace-mode-game .kv > text:last-child,
.workspace-mode-game .task-bottom,
.workspace-mode-game .value,
.workspace-mode-game .note { color: var(--ink); }

.workspace-mode-game .sub,
.workspace-mode-game .muted,
.workspace-mode-game .eyebrow,
.workspace-mode-game .mono,
.workspace-mode-game .history-item,
.workspace-mode-game .form-label,
.workspace-mode-game .list-count,
.workspace-mode-game .task-account,
.workspace-mode-game .task-period,
.workspace-mode-game .progress-caption,
.workspace-mode-game .kv > text:first-child,
.workspace-mode-game .brand-edition,
.workspace-mode-game .empty,
.workspace-mode-game .loading,
.workspace-mode-game .connection-row { color: var(--muted); }

.workspace-mode-game .link,
.workspace-mode-game .inline-action,
.workspace-mode-game .evidence-id { color: var(--blue); }

.workspace-mode-game .pill,
.workspace-mode-game .page-count {
  background: var(--surface-secondary);
  color: var(--muted);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
}

.workspace-mode-game .pill.amber { background: #302b22; color: #f2d59b; border-color: #68593c; }

.workspace-mode-game .pill.success { background: #17362e; color: var(--status-ok); border-color: #3a6253; }

.workspace-mode-game .pill.error { background: #3e242d; color: var(--status-error); border-color: #67434a; }

.workspace-mode-game .notice {
  color: #e6d5ad;
  background: #2b302e;
  border-color: #534f3c;
  border-radius: 10rpx;
}

.workspace-mode-game .notice.error { color: var(--status-error); background: #35232b; border-color: #69414e; }

.workspace-mode-game .primary,
.workspace-mode-game .secondary {
  min-height: 88rpx;
  border-radius: 8rpx;
  box-shadow: none;
}

.workspace-mode-game .primary {
  color: #18252a;
  background: linear-gradient(120deg, #e0cfa4, #c8b480);
  border-color: #e2cda0;
  font-weight: 670;
}

.workspace-mode-game .secondary {
  background: var(--surface-secondary);
  color: var(--ink);
  border-color: var(--line);
}

.workspace-mode-game .primary[disabled],
.workspace-mode-game .secondary[disabled] {
  background: var(--surface-secondary);
  border-color: var(--line);
  color: var(--muted);
}

.workspace-mode-game .danger { color: var(--status-error); }

.workspace-mode-game input,
.workspace-mode-game textarea,
.workspace-mode-game picker,
.workspace-mode-game .search-box input {
  background: var(--dark-input);
  border-color: #425359;
  border-radius: 8rpx;
  color: var(--ink);
}

.workspace-mode-game .chip { background: var(--surface); color: var(--muted); border-color: var(--line); }

.workspace-mode-game .chip.active { background: #303637; color: var(--blue-dark); border-color: #927c51; }

.workspace-mode-game .progress,
.workspace-mode-game .divider { background: var(--line); }

.workspace-mode-game .progress view { background: linear-gradient(90deg, #79ada4, #dcc28d); }

.workspace-mode-game .history-item { border-left-color: var(--line); }

.workspace-mode-game .empty-check,
.workspace-mode-game .profile-avatar { background: var(--surface-secondary); color: var(--blue-dark); }

.workspace-mode-game .mobile-brand { color: var(--ink); }

.workspace-mode-game .brand-link { border: 1rpx solid var(--line); height: 50rpx; border-radius: 9rpx; }

.workspace-mode-game .brand-link > view {
  width: 29rpx; height: 25rpx; border-width: 2rpx; border-color: var(--blue);
  border-radius: 0 15rpx 15rpx 0; transform: none; top: 11rpx; right: 9rpx;
}

.workspace-mode-game .brand-link > view:last-child {
  border: 0; border-left: 2rpx solid var(--blue);
  border-radius: 0; height: 34rpx; width: 1rpx; top: 7rpx; left: 15rpx;
}

.workspace-mode-game .login {
  min-height: 100vh;
  padding: 36rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  isolation: auto;
}

.workspace-mode-game .login-art { z-index: 0; height: 850rpx; }

.workspace-mode-game .login-art::after {
  background: linear-gradient(90deg, #0b202ba8, #10232d50), linear-gradient(0deg, #101c22, #101c2240 75%);
}

.workspace-mode-game .login .mobile-brand,
.workspace-mode-game .login .card-title { color: #f5efe0; }

.workspace-mode-game .login .brand-link > view,
.workspace-mode-game .login .brand-link > view:last-child { border-color: var(--blue); }

.workspace-mode-game .login .login-form {
  background: #14282fee;
  border-color: #a499773f;
  border-radius: 12rpx;
  box-shadow: 0 18rpx 40rpx #0611155f;
  margin: 34rpx 0 16rpx;
  padding: 28rpx;
}

.workspace-mode-game .login .login-form input { background: var(--dark-input); border-color: #425359; }

.workspace-mode-game .login .form-label { color: #c6d2c7; }

.workspace-mode-game .login .login-form .primary { margin-top: 26rpx; }

.workspace-mode-game .login-credit { position: relative; margin-top: 22rpx; font-size: 19rpx; color: var(--muted); }

.workspace-home { padding-left: 28rpx; padding-right: 28rpx; }
.workspace-home .brand-edition {
  display: flex; align-items: center; justify-content: flex-end; min-height: 68rpx;
  margin-left: auto; min-width: 0; text-align: right; color: var(--blue);
}
.workspace-picker-row { display: flex; gap: 12rpx; align-items: stretch; margin-top: 22rpx; }
.workspace-picker-row picker { flex: 1; min-width: 0; padding: 12rpx 16rpx; }
.workspace-picker-row .secondary { margin: 0; padding: 12rpx 16rpx; width: auto; flex-shrink: 0; }
.workspace-picker { display: flex; flex-direction: column; line-height: 1.4; }
.workspace-picker > text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-home .workspace-summary { padding: 0; }
.workspace-brief { position: relative; padding: 28rpx; overflow: hidden; }
.workspace-art { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.workspace-art image { width: 100%; height: 100%; }
.workspace-art::after {
  content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg, #14252df5, #14252d65);
}
.workspace-title, .workspace-meta, .workspace-brief .pill, .workspace-next { position: relative; }
.workspace-title { font-size: 39rpx; font-weight: 700; line-height: 1.35; }
.workspace-meta { margin-top: 8rpx; font-size: 22rpx; color: #d1dcd3; }
.workspace-brief .pill { margin-top: 12rpx; }
.workspace-brief .workspace-next { margin-top: 18rpx; width: auto; min-width: 210rpx; display: inline-flex; }
.workspace-queues { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1rpx solid var(--line); }
.workspace-queues > view { padding: 22rpx 28rpx; }
.workspace-queues > view + view { border-left: 1rpx solid var(--line); }
.queue-amount { font-size: 47rpx; color: var(--blue-dark); line-height: 1.3; }
.queue-amount > text { padding-left: 8rpx; font-size: 22rpx; color: var(--muted); }
.workspace-progress { padding: 20rpx 28rpx 12rpx; border-top: 1rpx solid var(--line); background: #14252d; }
.workspace-progress .row > text:last-child { color: var(--blue-dark); }
.workspace-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.workspace-steps .flow-button { margin: 0; min-height: 104rpx; padding: 10rpx 4rpx; font-size: 22rpx; gap: 0; flex-direction: column; }
.flow-symbol { color: var(--blue); font-size: 30rpx; font-weight: 600; }
.workspace-counts .muted { margin-top: 8rpx; }
.workspace-counts .divider { margin: 14rpx 0; }
